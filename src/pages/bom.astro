---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import PageShell from '../components/PageShell.astro';

// Google Sheets document ID from the original site
const sheetId = '1iUetA_pYtclu0xp49hT6BQEg4P8x2cyiJwjGDd_LRHs';
const sheetUrl = `https://docs.google.com/spreadsheets/d/${sheetId}`;
const embedUrl = `https://docs.google.com/spreadsheets/d/${sheetId}/pubhtml?widget=true&headers=false`;
---
<Layout title="Bill of Materials">
  <Nav slot="nav" />

  <PageShell
    title="BOM + Specs"
    subtitle="Full bill of materials with component specifications. The complete BOM is maintained in Google Sheets."
    badge="Engineering"
  >
    <div style="display:grid;gap:2rem;">

      <!-- Links -->
      <div style="display:flex;gap:1rem;flex-wrap:wrap;">
        <a href={sheetUrl} target="_blank" rel="noopener"
           style="display:inline-flex;align-items:center;gap:0.6rem;padding:0.65rem 1.25rem;
                  border-radius:0.5rem;font-weight:600;font-size:0.875rem;text-decoration:none;
                  color:#060e1c;background:#d4a017;transition:opacity 0.15s;"
           onmouseover="this.style.opacity='0.88'"
           onmouseout="this.style.opacity='1'">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/>
            <polyline points="15 3 21 3 21 9"/>
            <line x1="10" y1="14" x2="21" y2="3"/>
          </svg>
          Open Full BOM in Google Sheets
        </a>
      </div>

      <!-- Embedded Google Sheets -->
      <div>
        <h2 class="font-display" style="font-size:1.2rem;font-weight:700;color:#fff;margin:0 0 1rem;">
          Embedded BOM
        </h2>
        <div style="border-radius:0.75rem;overflow:hidden;border:1px solid rgba(212,160,23,0.15);
                    background:#0d1e35;">
          <iframe
            src={embedUrl}
            width="100%"
            height="520"
            frameborder="0"
            scrolling="yes"
            title="HexaFlow Bill of Materials"
            style="display:block;"
          ></iframe>
        </div>
        <p style="font-size:0.78rem;color:#475569;margin-top:0.6rem;">
          If the sheet does not appear, it may not be published. Open it directly using the button above,
          or go to File → Share → Publish to web in Google Sheets to enable embedding.
        </p>
      </div>

    </div>
  </PageShell>

  <Footer slot="footer" />
</Layout>
