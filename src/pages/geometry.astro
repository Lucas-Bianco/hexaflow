---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import PageShell from '../components/PageShell.astro';
---
<Layout title="Geometry">
  <Nav slot="nav" />

  <PageShell
    title="Geometry"
    subtitle="The unique geometry of our water delivery system efficiently utilizes capillary action and its amplified uses in microgravity."
    badge="Design"
  >

    <!-- Thorny Devil image + intro -->
    <div style="display:grid;grid-template-columns:1fr;gap:2.5rem;margin-bottom:3rem;" data-reveal>

      <div style="display:grid;grid-template-columns:1fr;gap:2rem;">

        <div>
          <h2 class="font-display kinetic" data-kinetic="word" data-reveal style="font-size:1.5rem;font-weight:700;color:#fff;margin:0 0 1rem;">
            Inspired by the Thorny Devil Lizard
          </h2>
          <p style="color:#94a3b8;line-height:1.75;margin:0 0 1rem;">
            The HexaFlow water delivery system draws from the <em>Moloch horridus</em> — the thorny devil lizard —
            which uses capillary action to transport water through microscopic grooved patterns on its skin.
            The honeycomb-like geometry of its scales passively moves water from any surface contact point
            directly to its mouth, with no muscular effort.
          </p>
          <p style="color:#94a3b8;line-height:1.75;margin:0 0 1rem;">
            HexaFlow replicates this hexagonal channel geometry at a functional scale using SLA 3D printing
            with resin material. Resin's polar properties create stronger adhesion bonds with water than
            water molecules share with each other — this is what drives the capillary flow. At the proper
            scale, the system can retain water even when fully inverted.
          </p>
          <p style="color:#94a3b8;line-height:1.75;margin:0;">
            The hexagons are spaced <strong style="color:#e2e8f0;">0.020 in (0.51 mm) apart</strong> — that gap is the
            capillary channel water travels through.
          </p>

          <!-- Channel geometry spec block -->
          <div class="card" data-reveal style="padding:1.1rem 1.25rem;margin:0 0 1.5rem;">
            <div class="section-label" style="margin-bottom:0.6rem;">Channel Geometry</div>
            <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(150px,1fr));gap:0.75rem;">
              <div>
                <div style="font-size:0.7rem;color:#64748b;text-transform:uppercase;letter-spacing:0.08em;">Side-to-side</div>
                <div class="font-display" style="font-size:1.05rem;font-weight:700;color:#d4a017;">0.167 in / 4.24 mm</div>
              </div>
              <div>
                <div style="font-size:0.7rem;color:#64748b;text-transform:uppercase;letter-spacing:0.08em;">Side length</div>
                <div class="font-display" style="font-size:1.05rem;font-weight:700;color:#d4a017;">0.100 in / 2.54 mm</div>
              </div>
              <div>
                <div style="font-size:0.7rem;color:#64748b;text-transform:uppercase;letter-spacing:0.08em;">Hexagon depth</div>
                <div class="font-display" style="font-size:1.05rem;font-weight:700;color:#d4a017;">0.050 in / 1.27 mm</div>
              </div>
              <div>
                <div style="font-size:0.7rem;color:#64748b;text-transform:uppercase;letter-spacing:0.08em;">Gap between hexagons</div>
                <div class="font-display" style="font-size:1.05rem;font-weight:700;color:#d4a017;">0.020 in / 0.51 mm</div>
              </div>
            </div>
          </div>

          <h3 class="font-display" data-reveal style="font-size:1.1rem;font-weight:700;color:#fff;margin:0 0 0.6rem;">
            Why the channels hold water
          </h3>
          <p style="color:#94a3b8;line-height:1.75;margin:0 0 1rem;">
            Resin is a polar material, so it bonds to water more strongly than water bonds to itself. That stronger
            adhesion is what drives efficient capillary transport through the hex network — and it lets the system
            hold water even when fully inverted. Only the critical hex dome is SLA-printed in resin; the body is FDM.
          </p>
          <p style="color:#94a3b8;line-height:1.75;margin:0;">
            Total channel capacity is <strong style="color:#e2e8f0;">10.12 mL</strong> (precisely 10.1155 mL) when fully
            saturated — roughly 10 minutes of constant flow at the 1 mL/min long-term pump rate to saturate.
          </p>
        </div>

        <!-- Thorny Devil photo -->
        <div style="border-radius:0.75rem;overflow:hidden;border:1px solid rgba(212,160,23,0.15);">
          <figure class="depth-fig" data-reveal>
            <div class="df-glow" data-layer="far" aria-hidden="true"></div>
            <img class="df-img" data-layer="mid"
              src="https://upload.wikimedia.org/wikipedia/commons/thumb/0/0b/Thorny_dragon.jpg/640px-Thorny_dragon.jpg"
              alt="Thorny devil lizard (Moloch horridus) — the biological inspiration for HexaFlow's hex channel geometry"
              loading="lazy"
            />
            <div class="df-hex" data-layer="near" aria-hidden="true"></div>
          </figure>
          <div style="padding:0.6rem 1rem;background:#0d1e35;font-size:0.78rem;color:#64748b;">
            <em>Moloch horridus</em> — thorny devil lizard. Its skin channels passively transport water via capillary action.
            <span style="color:#475569;"> (Image: Wikimedia Commons)</span>
          </div>
        </div>

        <!-- TDC Photos -->
        <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(260px,1fr));gap:1rem;">
          <div style="border-radius:0.75rem;overflow:hidden;border:1px solid rgba(212,160,23,0.15);" data-reveal>
            <figure class="depth-fig">
              <div class="df-glow" data-layer="far" aria-hidden="true"></div>
              <img class="df-img" data-layer="mid" src="/images/geometry-1.jpg" alt="TDC hex channel top-down view" loading="lazy"/>
              <div class="df-hex" data-layer="near" aria-hidden="true"></div>
            </figure>
            <div style="padding:0.5rem 0.85rem;background:#0d1e35;font-size:0.78rem;color:#64748b;">
              TDC hex channel — top view
            </div>
          </div>
          <div style="border-radius:0.75rem;overflow:hidden;border:1px solid rgba(212,160,23,0.15);" data-reveal>
            <figure class="depth-fig">
              <div class="df-glow" data-layer="far" aria-hidden="true"></div>
              <img class="df-img" data-layer="mid" src="/images/geometry-2.jpg" alt="TDC capillary channel close-up" loading="lazy"/>
              <div class="df-hex" data-layer="near" aria-hidden="true"></div>
            </figure>
            <div style="padding:0.5rem 0.85rem;background:#0d1e35;font-size:0.78rem;color:#64748b;">
              Capillary channel detail
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Specs grid -->
    <div data-reveal>
      <h2 class="font-display" style="font-size:1.5rem;font-weight:700;color:#fff;margin:0 0 1.25rem;">
        Technical Specifications
      </h2>
      <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:1rem;margin-bottom:2.5rem;">
        {[
          { label:'Channel Capacity',  value:'10.12 mL',        desc:'Precisely 10.1155 mL when fully saturated — ~10 min at 1 mL/min long-term pump' },
          { label:'Hex Spacing',       value:'0.020 in',         desc:'0.51 mm gap between hexagons — the capillary channel' },
          { label:'Side-to-Side',      value:'0.167 in',         desc:'4.24 mm hex span with 0.100 in (2.54 mm) side length' },
          { label:'Hexagon Depth',     value:'0.050 in',         desc:'1.27 mm — how far the hexagons are extruded' },
          { label:'Manufacturing',     value:'SLA Resin Dome',  desc:'Polar resin hex dome; FDM body. Only the dome is SLA-printed' },
          { label:'Surface Property',  value:'Polar Resin',     desc:'Stronger water adhesion than water-to-water cohesion' },
          { label:'Gravity Required',  value:'None',            desc:'Capillary action works in microgravity environments' },
          { label:'Inversion Test',    value:'Passes',          desc:'System retains water at proper scale when fully inverted' },
        ].map((s, i) => (
          <div class={`card reveal-${i + 1}`}>
            <div style="font-size:0.75rem;color:#64748b;text-transform:uppercase;letter-spacing:0.08em;margin-bottom:0.4rem;">{s.label}</div>
            <div class="font-display" style="font-size:1.25rem;font-weight:700;color:#d4a017;margin-bottom:0.3rem;">{s.value}</div>
            <div style="font-size:0.825rem;color:#64748b;line-height:1.5;">{s.desc}</div>
          </div>
        ))}
      </div>
    </div>

    <!-- Source -->
    <div data-reveal style="margin-top:2rem;padding:1rem 1.25rem;border-radius:0.5rem;
                background:rgba(212,160,23,0.04);border:1px solid rgba(212,160,23,0.12);">
      <p style="font-size:0.825rem;color:#64748b;margin:0;">
        <strong style="color:#94a3b8;">Source:</strong> Skin morphology study of <em>Moloch horridus</em> — ResearchGate.
        Capillary channel geometry and polar adhesion principles adapted for SLA resin fabrication.
      </p>
    </div>

  </PageShell>

  <Footer slot="footer" />
</Layout>
