---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import PageShell from '../components/PageShell.astro';
import PhotoGallery from '../components/PhotoGallery.astro';
---
<Layout title="Substrate Covers">
  <Nav slot="nav" />

  <PageShell
    title="Substrate Covers"
    subtitle="Covers for the rockwool and clay pebble substrates — holding material in place through microgravity while keeping moisture sensors and roots within reach."
    badge="Materials"
  >
    <div style="display:grid;gap:2.5rem;">

      <!-- Cover designs -->
      <div data-reveal>
        <h2 class="font-display kinetic" data-kinetic="word" data-reveal
            style="font-size:1.4rem;font-weight:700;color:#fff;margin:0 0 1.25rem;">
          Rockwool Cover
        </h2>
        <PhotoGallery photos={[
          { src:'/images/cover-1.jpg', caption:'Rockwool cover — 3D model' },
          { src:'/images/cover-2.jpg', caption:'Rockwool cover — physical model' },
          { src:'/images/cover-3.jpg', caption:'Rockwool cover — installed' },
        ]} />
      </div>

      <div data-reveal>
        <h2 class="font-display kinetic" data-kinetic="word" data-reveal
            style="font-size:1.4rem;font-weight:700;color:#fff;margin:0 0 1.25rem;">
          Clay Pebble Cover
        </h2>
        <PhotoGallery photos={[
          { src:'/images/cover-4.jpg', caption:'Clay pebble cover — 3D model' },
          { src:'/images/cover-5.jpg', caption:'Clay pebble cover — physical model' },
          { src:'/images/cover-6.jpg', caption:'Clay pebble cover — installed' },
        ]} />
      </div>

      <!-- Testing -->
      <div data-reveal>
        <h2 class="font-display" style="font-size:1.4rem;font-weight:700;color:#fff;margin:0 0 1rem;">
          Testing Methods
        </h2>
        <p style="color:#94a3b8;line-height:1.75;margin:0 0 1.25rem;">
          To test whether both covers would hold the substrate, we filled one of the aeroponic modules
          with the substrate being tested, held the cover over the opening where the substrate sits and
          gripped it tight, turned the whole system upside down, and shook it to see if the cover kept
          the substrate inside the system.
        </p>
        <PhotoGallery photos={[
          { src:'/images/cover-7.jpg', caption:'Rockwool cover — inverted test' },
          { src:'/images/cover-8.jpg', caption:'Clay pebble cover — inverted test' },
        ]} />
      </div>

      <!-- Iteration -->
      <div data-reveal>
        <h2 class="font-display kinetic" data-kinetic="word" data-reveal
            style="font-size:1.4rem;font-weight:700;color:#fff;margin:0 0 1.25rem;">
          Design Evolution
        </h2>
        <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(160px,1fr));gap:1rem;margin-bottom:1.25rem;">
          {[
            { v:'20', u:'Total iterations' },
            { v:'2',  u:'Rockwool cover' },
            { v:'18', u:'Clay pebble cover' },
          ].map((s, i) => (
            <div class={`card reveal-${i + 1}`} style="text-align:center;">
              <div class="font-display" style="font-size:2rem;font-weight:700;color:#d4a017;">{s.v}</div>
              <div style="font-size:0.8rem;color:#94a3b8;">{s.u}</div>
            </div>
          ))}
        </div>
        <ul style="color:#94a3b8;line-height:1.8;margin:0 0 1.25rem;padding-left:1.1rem;">
          <li>The first clay pebble concept used a center hole, which was abandoned because it restricted plant growth.</li>
          <li>After consulting with our teacher, the final design moved to a horizontal grate pattern.</li>
          <li>We sourced larger clay pebbles to allow better spacing in the grate.</li>
        </ul>
        <a href="https://docs.google.com/presentation/d/1_-8m7tZ-juv2WlxQdTwGwhvUoA7rGSbQcd5TkX5LsAc/present"
           target="_blank" rel="noopener" style="color:#d4a017;font-size:0.9rem;text-decoration:none;">
          Substrate Covers Iteration Photos →
        </a>
      </div>

      <!-- Back link -->
      <a href="/secondary-substrates"
         style="display:inline-flex;align-items:center;gap:0.5rem;font-size:0.875rem;
                color:#d4a017;text-decoration:none;"
         onmouseover="this.style.opacity='0.75'"
         onmouseout="this.style.opacity='1'">
        ← Back to Secondary Substrates
      </a>
    </div>
  </PageShell>

  <Footer slot="footer" />
</Layout>
