---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import PageShell from '../components/PageShell.astro';
---
<Layout title="Prototyping Iteration">
  <Nav slot="nav" />

  <PageShell
    title="Prototyping Iteration"
    subtitle="Iterative design and testing, traced from early concept builds through the final CDR prototype."
    badge="Process"
  >
    <div style="display:grid;gap:2rem;">

      <!-- External doc link -->
      <div data-reveal style="display:flex;align-items:center;gap:1rem;flex-wrap:wrap;">
        <div>
          <div class="font-display" style="font-weight:700;color:#fff;margin-bottom:0.3rem;">
            Prototyping &amp; Testing Document
          </div>
          <div style="font-size:0.875rem;color:#64748b;">
            The complete iteration log lives in a Google Doc.
          </div>
        </div>
        <a href="https://docs.google.com/document/d/1mPJAwG1Ol5GxjGxR4yMpjgsXZvpFl077luVPZ-7qj7U" target="_blank" rel="noopener"
           style="display:inline-flex;align-items:center;gap:0.5rem;padding:0.6rem 1.25rem;
                  border-radius:0.5rem;font-weight:600;font-size:0.875rem;text-decoration:none;
                  color:#060e1c;background:#d4a017;white-space:nowrap;transition:opacity 0.15s;"
           onmouseover="this.style.opacity='0.88'"
           onmouseout="this.style.opacity='1'">
          Open Google Doc
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
            <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/>
            <polyline points="15 3 21 3 21 9"/>
            <line x1="10" y1="14" x2="21" y2="3"/>
          </svg>
        </a>
      </div>

      <!-- Embedded doc -->
      <div data-reveal style="border-radius:0.75rem;overflow:hidden;border:1px solid rgba(212,160,23,0.15);background:#0d1e35;">
        <div style="padding:0.75rem 1rem;background:rgba(212,160,23,0.06);border-bottom:1px solid rgba(212,160,23,0.12);
                    font-size:0.8rem;color:#64748b;">
          Embedded Google Docs — Prototyping and Testing
        </div>
        <iframe
          src="https://docs.google.com/document/d/1mPJAwG1Ol5GxjGxR4yMpjgsXZvpFl077luVPZ-7qj7U/preview"
          width="100%"
          height="600"
          frameborder="0"
          title="HexaFlow Prototyping and Testing Document"
          style="display:block;"
        ></iframe>
        <div style="padding:0.75rem 1rem;font-size:0.78rem;color:#475569;background:#091829;">
          If the document doesn't load here, use the Open Google Doc button above.
        </div>
      </div>

      <!-- Known iteration notes -->
      <div>
        <h2 class="font-display kinetic" data-kinetic="word" data-reveal style="font-size:1.3rem;font-weight:700;color:#fff;margin:0 0 0.75rem;">
          Iteration Summary
        </h2>
        <p style="color:#94a3b8;font-size:0.9rem;line-height:1.7;margin:0 0 1.25rem;">
          The major milestones that shaped the design — each one a deliberate response to what the
          previous build revealed.
        </p>
        <div class="iter-grid" data-reveal style="display:grid;gap:1rem;">
          {[
            { phase:'Substrate Testing',   desc:'Tested 8 materials — mold grew in all of them; only pine bark produced substantial growth.' },
            { phase:'TDC V1',              desc:'First hexagonal capillary plate using SLA resin. Verified capillary action and inversion water retention at 10.12mL capacity.' },
            { phase:'TDC V2',              desc:'Resin hex-dome top on an FDM-printed bottom — much lighter and cheaper than the original "brick," with room for cameras inside.' },
            { phase:'Drop Test Iteration', desc:'Refined drop test configuration — removed TDS/pH sensors, upgraded to a high-capacity pump to fill as much of the ≈ 10.12 mL channel capacity as possible in 2.2 s.' },
            { phase:'AI Integration',      desc:'Vision model trained to classify roots as dry or wet. Active in long-term growing; disengaged during drop tests.' },
            { phase:'Custom PCB', desc:'Consolidated electronics: Pi Zero 2W, 4-camera USB hub, onboard ADC, power breakouts — simplified wiring for reliability.' },
          ].map(p => (
            <div class="card" style="display:grid;grid-template-columns:auto 1fr;gap:1.25rem;align-items:start;">
              <div style="width:10px;height:10px;border-radius:50%;background:rgba(212,160,23,0.4);
                           border:2px solid #d4a017;flex-shrink:0;margin-top:4px;"></div>
              <div>
                <div class="font-display" style="font-weight:700;color:#fff;margin-bottom:0.3rem;font-size:0.95rem;">{p.phase}</div>
                <div style="font-size:0.875rem;color:#64748b;line-height:1.6;">{p.desc}</div>
              </div>
            </div>
          ))}
        </div>
      </div>

    </div>
  </PageShell>

  <Footer slot="footer" />
</Layout>

<style>
  /* Opacity-only stagger so we never fight the .card hover-lift transform. */
  .iter-grid > .card { opacity: 1; }
  .iter-grid.is-in > .card { opacity: 1; }
  .iter-grid.is-in > .card:nth-child(2) { transition-delay: .08s; }
  .iter-grid.is-in > .card:nth-child(3) { transition-delay: .16s; }
  .iter-grid.is-in > .card:nth-child(4) { transition-delay: .24s; }
  .iter-grid.is-in > .card:nth-child(5) { transition-delay: .32s; }
  .iter-grid.is-in > .card:nth-child(6) { transition-delay: .40s; }
  @media (prefers-reduced-motion: reduce) {
    .iter-grid > .card { opacity: 1 !important; }
  }
</style>
