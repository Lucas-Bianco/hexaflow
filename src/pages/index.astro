---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { withBase } from '../lib/base.js';
import CinematicHero from '../components/CinematicHero.astro';
import StackedCards from '../components/StackedCards.astro';

const team = [
  { name: 'Aidan',   role: 'Project Manager & Hardware Lead'      },
  { name: 'Nate',    role: 'Correspondent & Water Movement Lead'   },
  { name: 'Sabrina', role: 'Note Taker & Substrate Lead'           },
  { name: 'Maddie',  role: 'Scheduler & Modularity Lead'           },
  { name: 'Lucas',   role: 'Web Development Lead'                   },
];

// Measured results lead. `n`/`dp` drive the scroll count-up; `suffix` is static
// so the unit never animates. Sourced from Capillary Physical Tests (Suite B,
// 9 drops) and Volume of hexagon grooves.
const stats = [
  { n: 14.7,  dp: 1, suffix: ' mm', u: 'Mean Capillary Rise', note: 'measured, 9 drops' },
  { n: 9,     dp: 0, suffix: '',    u: 'Free-Fall Drop Tests', note: 'Suite B' },
  { n: 10.12, dp: 2, suffix: ' mL', u: 'Channel Capacity',    note: 'fully saturated' },
  { n: 0.48,  dp: 2, suffix: ' mm', u: 'Channel Width',       note: '0.020 in gap' },
];

// Horizontal build story. Every claim here is one the NASA HUNCH document
// review verified against the team's own records — no rounding, no inference.
const journey = [
  { t: 'The pivot',
    d: 'Eight substrates went into testing in October. Nearly all of them grew mould; only pine bark produced any growth at all. On 22 October the team abandoned growing media entirely and went aeroponic.',
    img: '/images/substrate-1.jpg', alt: 'Substrate samples under test' },
  { t: 'The lizard',
    d: 'The thorny devil moves water across its skin through grooved channels, against gravity, with no pump. Sabrina found it. It became a hexagonal capillary lattice 0.48 mm across.',
    img: '/images/geometry-1.jpg', alt: 'Hexagonal capillary channel geometry' },
  { t: 'PDR',
    d: 'NASA’s reviewer called the hex geometry "terrific." Peer teams were blunter — they warned that wicking may not behave the same way in microgravity. Both notes shaped the next six months.',
    img: '/images/geometry-2.jpg', alt: 'Capillary geometry detail' },
  { t: 'The matrix',
    d: 'On 15 December four substrates were scored on feasibility in microgravity, containment and growth. Rockwool took it at 13; clay pebbles followed at 12.',
    img: '/images/substrate-5.jpg', alt: 'Substrate decision matrix testing' },
  { t: 'Fifteen drops',
    d: 'Two suites from 14 feet. The first six drops averaged about 9.9 mm of capillary movement. After the module was revised, the next nine averaged 14.7 mm — a 48% improvement.',
    img: '/images/drop-test-1.jpg', alt: 'Drop test in progress' },
  { t: 'What broke',
    d: 'The kale kept dying. The cause turned out to be the team’s own new resin printer, running unventilated in the same room. Both plants shrivelled before anyone connected the two.',
    img: '/images/aeroponics-1.jpg', alt: 'Aeroponic plant growth testing' },
];

const deck = journey.map((j, i) => ({
  k: String(i + 1).padStart(2, '0'),
  title: j.t, body: j.d, img: j.img, alt: j.alt,
}));

const features = [
  { title: 'Hexagonal Geometry', href: '/geometry', k: '01',
    desc: 'Thorny-devil-inspired channels move water by capillary action — 10.12 mL capacity, 0.48 mm channels, SLA-printed resin dome.' },
  { title: 'AI Vision Control',  href: '/ai-control', k: '02',
    desc: 'A vision model reads root moisture and triggers the pump only when the plant needs it — a continuous feedback loop that prevents overwatering.' },
  { title: 'Aeroponics',         href: '/aeroponics', k: '03',
    desc: 'Plants hang in air and draw water straight from the channels — watered only when the roots are dry, with no growing medium to rot.' },
  { title: 'Modular Design',     href: '/modular-enclosure', k: '04',
    desc: 'A sliding shelf system that supports two configurations from one enclosure: drop-test (high-capacity pump) and long-term (precision pump + sensors).' },
];
---

<Layout title="Home" description="HexaFlow – A modular capillary action nanolab that uses AI vision and biomimicry to deliver water to plants.">
  <Nav slot="nav" />

  <!-- ── MorphBackground: chapter color-worlds, fixed behind everything ── -->
  <div class="bg-world" aria-hidden="true">
    <div class="bg-world-layer" data-world="enclosure" style="background:var(--world-enclosure)"></div>
    <div class="bg-world-layer" data-world="tdc"       style="background:var(--world-tdc)"></div>
    <div class="bg-world-layer" data-world="water"    style="background:var(--world-water)"></div>
    <div class="bg-world-layer" data-world="substrate" style="background:var(--world-substrate)"></div>
  </div>

  <!-- ── Cinematic hero: scroll scrubs a 90-frame macro pan of the lattice ── -->
  <CinematicHero>
    <div class="hero-mark reveal reveal-1">
      <img src={withBase('/images/logo-gold.png')} width="512" height="458"
           alt="HexaFlow logo — a cluster of hexagonal capillary channels"
           class="hero-logo" decoding="async" fetchpriority="high" />
    </div>

    <span class="hero-eyebrow reveal reveal-2">Tri-County RVTHS · NASA HUNCH</span>
    <h1 class="hero-title kinetic" data-kinetic="char">HexaFlow</h1>
    <p class="hero-sub reveal reveal-3">Water that climbs in free-fall</p>
    <p class="hero-lede reveal reveal-3">
      Hexagonal capillary channels copied from the thorny devil lizard, carrying
      water to plant roots where gravity can't help. Nine free-fall drops,
      14.7 mm of measured capillary movement, inside a 2U nanolab.
    </p>
    <div class="hero-cta reveal reveal-4">
      <a class="btn btn-primary" href={withBase('/assembly')}>Explore the Assembly →</a>
      <a class="btn btn-ghost" href={withBase('/drop-testing')}>See the Results</a>
    </div>
  </CinematicHero>

  <!-- ── Stats: count up on entry ──────────────────────────────────────── -->
  <section class="stats vel" aria-label="Key figures" data-reveal>
    {stats.map(s => (
      <div class="stat">
        <span class="stat-v font-display">
          {/* Real value is the rendered fallback — if JS or rAF never runs
              (background tab, no-JS), the correct figure is still shown. */}
          <span data-count={s.n} data-decimals={s.dp}>{s.n.toFixed(s.dp)}</span>{s.suffix}
        </span>
        <span class="stat-u">{s.u}</span>
        <span class="stat-n">{s.note}</span>
      </div>
    ))}
  </section>

  <!-- ── About ─────────────────────────────────────────────────────────── -->
  <section class="wrap about" data-reveal data-chapter="enclosure">
    <div class="about-art" aria-hidden="true">
      <div class="hex-stack">
        <span class="hex hex-a"></span>
        <span class="hex hex-b"></span>
        <span class="hex hex-c"></span>
      </div>
    </div>
    <div class="about-body">
      <div class="section-label">About the Project</div>
      <h2 class="font-display about-h">What is HexaFlow?</h2>
      <p>
        HexaFlow is a modular capillary action nanolab that uses AI vision and biomimicry to deliver
        water to plants. A five-member team from Tri-County RVTHS built the system to prevent root
        rot while enabling interchangeable experiments and rapid data collection — all inside a
        <strong>5.18-second test window</strong>.
      </p>
      <p>
        The hexagonal channels take their cue from the <strong>thorny devil lizard</strong>
        (<em>Moloch horridus</em>), which transports water through grooved skin by capillary action.
        A vision model reads root moisture from the camera and drives the pump, closing a continuous
        feedback loop that prevents overwatering and root rot.
      </p>
      <p>
        Manufacturing relies on SLA 3D printing in resin. Resin's polar bonds grip water more tightly
        than water molecules grip each other, driving efficient capillary transport — strong enough
        that the system holds water even when inverted.
      </p>
    </div>
  </section>

  <!-- ── Features ─────────────────────────────────────────────────────── -->
  <section class="features" data-chapter="water">
    <div class="wrap">
      <div class="features-head" data-reveal>
        <div class="section-label">Core Systems</div>
        <h2 class="font-display features-h">How It Works</h2>
        <p class="features-sub">Four interlocking systems, one closed-loop nanolab.</p>
      </div>
      <div class="features-grid" data-reveal>
        {features.map(f => (
          <a class="card feat" href={withBase(f.href)}>
            <span class="feat-k font-display">{f.k}</span>
            <h3 class="font-display feat-title">{f.title}</h3>
            <p class="feat-desc">{f.desc}</p>
            <span class="feat-link">Learn more →</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- ── Stacked build story ───────────────────────────────────────────── -->
  <StackedCards cards={deck} label="The Build" heading="From a lizard to a nanolab." />

  <!-- ── Team ──────────────────────────────────────────────────────────── -->
  <section id="team" class="wrap team">
    <div class="team-head" data-reveal>
      <div class="section-label">The People</div>
      <h2 class="font-display team-h">Our Team</h2>
      <p class="team-sub">Tri-County RVTHS · Franklin, Massachusetts</p>
    </div>

    <figure class="team-photo depth-fig" data-reveal>
      <div class="df-glow" data-layer="far" aria-hidden="true"></div>
      <img class="df-img" data-layer="mid" src={withBase('/images/home-team.jpg')}
           width="2047" height="1196" loading="lazy" decoding="async"
           alt="The five-member HexaFlow team in the Tri-County engineering shop, in front of their project planning board" />
    </figure>

    <div class="team-grid" data-reveal>
      {team.map(m => (
        <div class="card member">
          <div class="member-avatar">{m.name[0]}</div>
          <div class="member-name font-display">{m.name}</div>
          <div class="member-role">{m.role}</div>
        </div>
      ))}
    </div>
  </section>

  <Footer slot="footer" />
</Layout>

<style>
  /* ── Hero ───────────────────────────────────────────────────────────── */
  .hero { position: relative; min-height: 92vh; display: flex; align-items: center;
          justify-content: center; overflow: hidden; padding: 6rem 1.5rem 4rem; }
  .hero-inner { position: relative; text-align: center; max-width: 52rem; }
  .hero-mark { display: flex; justify-content: center; margin-bottom: 1.75rem; }
  /* The real team mark (recoloured to brand gold from the source artwork's alpha).
     Sized so the honeycomb cells stay individually legible — below ~110px the
     0.8px strokes alias into a solid blob. */
  .hero-logo { width: clamp(112px, 16vw, 168px); height: auto;
    filter: drop-shadow(0 0 28px rgba(212,160,23,0.28)); }
  .hero-eyebrow {
    display: inline-block; font-size: 0.72rem; font-weight: 600; letter-spacing: 0.18em;
    text-transform: uppercase; color: var(--hex-gold);
    padding: 0.35rem 0.85rem; border: 1px solid var(--hex-line); border-radius: 999px;
    background: rgba(212,160,23,0.05); margin-bottom: 1.5rem;
  }
  .hero-title { font-size: clamp(3.2rem, 9vw, 6rem); font-weight: 700; color: var(--hex-text);
    letter-spacing: -0.03em; line-height: 0.95; margin: 0 0 1rem;
    text-shadow: 0 0 60px rgba(212,160,23,0.15); }
  .hero-sub { font-size: 1.25rem; color: var(--hex-gold); font-weight: 600;
    letter-spacing: 0.01em; margin: 0 0 1.1rem; }
  .hero-lede { color: var(--hex-muted); font-size: 1.05rem; line-height: 1.7;
    max-width: 38rem; margin: 0 auto 2.5rem; }
  .hero-cta { display: flex; gap: 1rem; justify-content: center; flex-wrap: wrap; }
  .btn { padding: 0.8rem 1.85rem; border-radius: 0.55rem; font-weight: 600;
    font-size: 0.95rem; text-decoration: none; transition: transform .15s, background .15s, border-color .15s; }
  .btn:hover { transform: translateY(-1px); }
  .btn-primary { color: #060e1c; background: var(--hex-gold);
    box-shadow: 0 10px 24px -10px rgba(212,160,23,0.7); }
  .btn-primary:hover { background: #e4b125; }
  .btn-ghost { color: var(--hex-gold); border: 1px solid rgba(212,160,23,0.35); }
  .btn-ghost:hover { background: rgba(212,160,23,0.08); }
  .hero-scroll { position: absolute; bottom: 1.75rem; left: 50%; transform: translateX(-50%);
    display: flex; flex-direction: column; align-items: center; gap: 0.5rem;
    font-size: 0.65rem; letter-spacing: 0.2em; text-transform: uppercase; color: var(--hex-muted); }
  .hero-scroll-line { width: 1px; height: 32px; background: linear-gradient(var(--hex-gold), transparent);
    animation: hf-pulse 2.4s ease-in-out infinite; }
  @keyframes hf-pulse { 0%,100% { opacity: 0.3; transform: scaleY(0.7); } 50% { opacity: 1; transform: scaleY(1); } }

  /* ── Stats ──────────────────────────────────────────────────────────── */
  .stats {
    display: grid; grid-template-columns: repeat(2, 1fr);
    border-top: 1px solid var(--hex-line); border-bottom: 1px solid var(--hex-line);
    background: var(--hex-surface);
  }
  .stat { text-align: center; padding: 2.1rem 1rem; border-bottom: 1px solid var(--hex-line);
    border-right: 1px solid var(--hex-line); }
  .stat:nth-child(2n) { border-right: 0; }
  .stat:nth-last-child(-n+2) { border-bottom: 0; }
  .stat-v { display: block; font-size: 1.95rem; font-weight: 700; color: var(--hex-gold); line-height: 1; }
  .stat-u { display: block; font-size: 0.72rem; color: var(--hex-muted);
    text-transform: uppercase; letter-spacing: 0.12em; margin-top: 0.45rem; }
  /* Provenance under each figure — a reviewer should see at a glance which
     numbers were measured and which are design targets. */
  .stat-n { display: block; font-size: 0.68rem; color: var(--hex-muted-2);
    margin-top: 0.3rem; font-style: italic; }
  @media (min-width: 640px) {
    .stats { grid-template-columns: repeat(4, 1fr); }
    .stat { border-bottom: 0; }
    .stat:nth-child(2n) { border-right: 1px solid var(--hex-line); }
    .stat:last-child { border-right: 0; }
  }

  /* ── Layout helpers ─────────────────────────────────────────────────── */
  .wrap { max-width: 72rem; margin: 0 auto; padding: 5.5rem 1.5rem; }

  /* ── About ──────────────────────────────────────────────────────────── */
  .about { display: grid; grid-template-columns: 1fr; gap: 2.5rem; align-items: center; }
  @media (min-width: 880px) { .about { grid-template-columns: 0.7fr 1.3fr; gap: 3.5rem; } }
  .about-art { display: flex; justify-content: center; }
  .hex-stack { position: relative; width: 220px; height: 240px; }
  .hex { position: absolute; width: 150px; height: 170px;
    background: linear-gradient(160deg, rgba(212,160,23,0.12), rgba(212,160,23,0.02));
    border: 1px solid var(--hex-line); clip-path: polygon(50% 0, 100% 25%, 100% 75%, 50% 100%, 0 75%, 0 25%); }
  .hex-a { top: 0; left: 35px; }
  .hex-b { top: 50px; left: 0; border-color: rgba(212,160,23,0.28); }
  .hex-c { top: 50px; left: 70px; background: linear-gradient(160deg, rgba(212,160,23,0.18), transparent); }
  .about-h { font-size: 2rem; font-weight: 700; color: var(--hex-text); margin: 0 0 1.25rem; }
  .about-body p { color: var(--hex-muted); line-height: 1.75; margin: 0 0 1rem; }
  .about-body strong { color: #e2e8f0; }

  /* ── Features ───────────────────────────────────────────────────────── */
  .features { background: var(--hex-surface);
    border-top: 1px solid var(--hex-line); border-bottom: 1px solid var(--hex-line); }
  .features-head { text-align: center; margin-bottom: 3rem; }
  .features-head .section-label { justify-content: center; }
  .features-h { font-size: 2rem; font-weight: 700; color: var(--hex-text); margin: 0 0 0.6rem; }
  .features-sub { color: var(--hex-muted); margin: 0; }
  .features-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 1.25rem; }
  .feat { position: relative; display: block; text-decoration: none; }
  .feat-k { position: absolute; top: 1.1rem; right: 1.3rem; font-size: 0.85rem; font-weight: 700;
    color: rgba(212,160,23,0.35); letter-spacing: 0.05em; }
  .feat-title { font-size: 1.05rem; font-weight: 700; color: var(--hex-text); margin: 0 0 0.6rem; }
  .feat-desc { font-size: 0.875rem; color: var(--hex-muted); line-height: 1.65; margin: 0 0 1.1rem; }
  .feat-link { font-size: 0.8rem; color: var(--hex-gold); font-weight: 600; }

  /* ── Team ───────────────────────────────────────────────────────────── */
  .team-head { text-align: center; margin-bottom: 3rem; }
  .team-head .section-label { justify-content: center; }
  .team-h { font-size: 2rem; font-weight: 700; color: var(--hex-text); margin: 0 0 0.5rem; }
  .team-sub { color: var(--hex-muted); margin: 0; }
  .team-photo { margin: 0 0 2.5rem; }
  .team-photo .df-img { width: 100%; height: auto; display: block;
    border-radius: 0.85rem; border: 1px solid var(--hex-line); }
  .team-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: 1rem; }
  .member { text-align: center; }
  .member-avatar { width: 56px; height: 56px; border-radius: 50%; margin: 0 auto 0.9rem;
    display: grid; place-items: center;
    background: rgba(212,160,23,0.12); border: 1px solid rgba(212,160,23,0.35);
    font-family: 'Space Grotesk', sans-serif; font-weight: 700; font-size: 1.3rem; color: var(--hex-gold);
    transition: transform .2s, box-shadow .2s; }
  .member:hover .member-avatar { transform: scale(1.06); box-shadow: 0 0 0 4px rgba(212,160,23,0.15); }
  .member-name { font-weight: 700; color: var(--hex-text); margin-bottom: 0.35rem; }
  .member-role { font-size: 0.8rem; color: var(--hex-muted); line-height: 1.5; }

  /* Staggered children when their container reveals (opacity-only, so it
     never fights the .card hover-lift transform). */
  .stats > .stat,
  .features-grid > .feat,
  .team-grid > .member { opacity: 0; transition: opacity .6s ease; }
  .stats.is-in > .stat,
  .features-grid.is-in > .feat,
  .team-grid.is-in > .member { opacity: 1; }
  .stats.is-in > .stat:nth-child(2),
  .features-grid.is-in > .feat:nth-child(2),
  .team-grid.is-in > .member:nth-child(2) { transition-delay: .08s; }
  .stats.is-in > .stat:nth-child(3),
  .features-grid.is-in > .feat:nth-child(3),
  .team-grid.is-in > .member:nth-child(3) { transition-delay: .16s; }
  .stats.is-in > .stat:nth-child(4),
  .features-grid.is-in > .feat:nth-child(4),
  .team-grid.is-in > .member:nth-child(4) { transition-delay: .24s; }
  .team-grid.is-in > .member:nth-child(5) { transition-delay: .32s; }

  @media (prefers-reduced-motion: reduce) {
    .stats > .stat, .features-grid > .feat, .team-grid > .member { opacity: 1 !important; }
  }
</style>