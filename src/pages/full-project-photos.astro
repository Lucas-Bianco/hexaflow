---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import PageShell from '../components/PageShell.astro';
import PhotoGallery from '../components/PhotoGallery.astro';

const photos = [
  { src:'/images/project-1.jpg',  caption:'Assembled nanolab, lit up' },
  { src:'/images/project-2.jpg',  caption:'Assembled nanolab — side view' },
  { src:'/images/project-3.jpg',  caption:'TDC V2 from above, with plant clips' },
  { src:'/images/project-4.jpg',  caption:'TDC V2 assembled' },
  { src:'/images/project-5.jpg',  caption:'TDC V2 assembled — angled' },
  { src:'/images/project-6.jpg',  caption:'Raspberry Pi Zero 2W on the HexaFlow PCB' },
  { src:'/images/project-7.jpg',  caption:'HexaFlow PCB' },
  { src:'/images/project-8.jpg',  caption:'Enclosure with USB cable' },
  { src:'/images/project-9.jpg',  caption:'Enclosure closed up' },
  { src:'/images/project-10.jpg', caption:'Enclosure open — shelf system' },
  { src:'/images/project-11.jpg', caption:'Clay pebble grate on the TDC' },
  { src:'/images/project-12.jpg', caption:'Enclosure with the clay pebble grate on top' },
  { src:'/images/project-13.jpg', caption:'Empty enclosure shell' },
  { src:'/images/project-14.jpg', caption:'TDC with kale in the plant clips' },
  { src:'/images/project-15.jpg', caption:'TDC V2 from above' },
];
---
<Layout title="Full Project Photos">
  <Nav slot="nav" />

  <PageShell
    title="Photos of Full Project &amp; TDC"
    subtitle="Project photographs of the full HexaFlow nanolab — the enclosure, the TDC module, and the electronics."
    badge="Gallery"
  >
    <div style="display:grid;gap:2rem;">

      <div data-reveal>
        <h2 class="font-display kinetic" data-kinetic="word" data-reveal style="font-size:1.4rem;font-weight:700;color:#fff;margin:0 0 0.75rem;">
          Project Gallery
        </h2>
        <PhotoGallery photos={photos} />
      </div>

    </div>
  </PageShell>

  <Footer slot="footer" />
</Layout>

<style>
  .photo-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
    gap: 1rem;
  }
  .gi {
    border-radius: 0.75rem;
    overflow: hidden;
    border: 1px solid var(--hex-line);
  }
  .gi img {
    width: 100%;
    display: block;
    object-fit: cover;
    max-height: 200px;
  }
  .gi-caption {
    padding: 0.5rem 0.85rem;
    background: var(--hex-card);
  }
  .gi-num {
    font-size: 0.7rem;
    color: #475569;
    margin-bottom: 0.1rem;
  }
  .gi-text {
    font-size: 0.8rem;
    color: var(--hex-muted);
  }
  /* DepthFigure hero items — span 2 columns and crop taller for prominence */
  .depth-fig.featured {
    grid-column: span 2;
  }
  .depth-fig.featured .df-img {
    height: 320px;
    object-fit: cover;
  }
</style>
