---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import PageShell from '../components/PageShell.astro';
---
<Layout title="Aeroponics">
  <Nav slot="nav" />

  <PageShell
    title="Aeroponics"
    subtitle="Plants suspended in air, roots drinking directly from the hexagonal channel system — aeroponics is the Nanolab's primary growing method, avoiding the complications of substrate-water interaction in microgravity."
    badge="Biology"
  >
    <div style="display:grid;gap:2.5rem;">

      <!-- Overview -->
      <div style="display:grid;grid-template-columns:1fr;gap:2rem;" data-reveal>
        <div>
          <h2 class="font-display kinetic" data-kinetic="word" data-reveal
              style="font-size:1.4rem;font-weight:700;color:#fff;margin:0 0 1rem;">
            How It Works in HexaFlow
          </h2>
          <p style="color:#94a3b8;line-height:1.75;margin:0 0 1rem;">
            In microgravity, plants grow on the TDC Delivery System with roots absorbing water
            directly from the channel system — sidestepping the complications of substrate-water
            interaction in zero gravity.
          </p>
          <p style="color:#94a3b8;line-height:1.75;margin:0 0 1rem;">
            <strong style="color:#e2e8f0;">Plant clips</strong> secure vegetation both on Earth and in space.
            Inserted into TDC holes, they grip the stem firmly enough that the team verified retention by
            inverting the TDC with kale threaded through both clips for one full minute — plants stayed put.
          </p>
          <p style="color:#94a3b8;line-height:1.75;margin:0 0 1rem;">
            Aeroponics is the primary growing method because it removes the substrate from the equation — no
            growing medium for water to interact with in microgravity. The AI vision model reads root moisture from the
            camera feed and waters only when the roots are dry, a continuous feedback loop that
            <strong style="color:#e2e8f0;">prevents root rot</strong>.
          </p>
          <p style="color:#94a3b8;line-height:1.75;margin:0;">
            The customizable water/nutrient reservoir is built from recyclable materials — a plastic bag, a VEX fitting, and
            a heat sealer — a modular design that scales across HexaFlow configurations and future
            expansion.
          </p>
        </div>
      </div>

      <!-- Benefits -->
      <div data-reveal>
        <h2 class="font-display" style="font-size:1.4rem;font-weight:700;color:#fff;margin:0 0 1.25rem;">
          Why Aeroponics Wins
        </h2>
        <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:1rem;">
          {[
            { stat:'Dry Roots',    label:'Triggered Watering', desc:'AI vision waters only when roots are dry, helping prevent root rot' },
            { stat:'Suspended',    label:'Root System',      desc:'Roots hang in air — maximum oxygen exposure' },
            { stat:'Faster', label:'Root Gas Exchange', desc:'Roots are constantly exposed to the air' },
            { stat:'None',         label:'Gravity Required', desc:'System works in microgravity environments' },
          ].map((s, i) => (
            <div class={`card reveal-${i + 1}`}>
              <div class="font-display" style="font-size:1.5rem;font-weight:700;color:#d4a017;margin-bottom:0.25rem;">{s.stat}</div>
              <div style="font-weight:600;color:#fff;font-size:0.9rem;margin-bottom:0.35rem;">{s.label}</div>
              <div style="font-size:0.825rem;color:#64748b;">{s.desc}</div>
            </div>
          ))}
        </div>
      </div>

      <!-- Aeroponics photos -->
      <div data-reveal>
        <h2 class="font-display" style="font-size:1.4rem;font-weight:700;color:#fff;margin:0 0 1.25rem;">
          Build & Verification
        </h2>
        <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:1rem;">
          <div style="border-radius:0.75rem;overflow:hidden;border:1px solid rgba(212,160,23,0.15);">
            <figure class="depth-fig" data-reveal>
              <div class="df-glow" data-layer="far" aria-hidden="true"></div>
              <img class="df-img" data-layer="mid" src="/images/aeroponics-1.jpg" alt="Plant clips securing kale in TDC" loading="lazy" />
              <div class="df-hex" data-layer="near" aria-hidden="true"></div>
            </figure>
            <div style="padding:0.5rem 0.85rem;background:#0d1e35;font-size:0.78rem;color:#64748b;">Plant clips securing kale in the TDC</div>
          </div>
          <div style="border-radius:0.75rem;overflow:hidden;border:1px solid rgba(212,160,23,0.15);">
            <figure class="depth-fig" data-reveal>
              <div class="df-glow" data-layer="far" aria-hidden="true"></div>
              <img class="df-img" data-layer="mid" src="/images/aeroponics-2.jpg" alt="TDC held upside down with kale in the plant clips" loading="lazy" />
              <div class="df-hex" data-layer="near" aria-hidden="true"></div>
            </figure>
            <div style="padding:0.5rem 0.85rem;background:#0d1e35;font-size:0.78rem;color:#64748b;">Inversion test — TDC held upside down</div>
          </div>
          <div style="border-radius:0.75rem;overflow:hidden;border:1px solid rgba(212,160,23,0.15);">
            <figure class="depth-fig" data-reveal>
              <div class="df-glow" data-layer="far" aria-hidden="true"></div>
              <img class="df-img" data-layer="mid" src="/images/aeroponics-3.jpg" alt="Kale threaded through the plant clips in the TDC" loading="lazy" />
              <div class="df-hex" data-layer="near" aria-hidden="true"></div>
            </figure>
            <div style="padding:0.5rem 0.85rem;background:#0d1e35;font-size:0.78rem;color:#64748b;">Kale secured in the plant clips</div>
          </div>
          <div style="border-radius:0.75rem;overflow:hidden;border:1px solid rgba(212,160,23,0.15);">
            <figure class="depth-fig" data-reveal>
              <div class="df-glow" data-layer="far" aria-hidden="true"></div>
              <img class="df-img" data-layer="mid" src="/images/aeroponics-4.jpg" alt="Heat-sealed water and nutrient reservoir with VEX fitting" loading="lazy" />
              <div class="df-hex" data-layer="near" aria-hidden="true"></div>
            </figure>
            <div style="padding:0.5rem 0.85rem;background:#0d1e35;font-size:0.78rem;color:#64748b;">Water/nutrient reservoir — heat-sealed bag with VEX fitting</div>
          </div>
        </div>
      </div>

      <!-- Suitable crops -->
      <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(300px,1fr));gap:1.5rem;" data-reveal>
        <div class="card reveal-1">
          <div class="section-label" style="margin-bottom:0.75rem;">Suitable Crops</div>
          <ul style="color:#94a3b8;font-size:0.875rem;line-height:2;margin:0;padding-left:1.1rem;">
            <li>Leafy greens</li>
            <li>Vegetables</li>
            <li>Small flowering plants</li>
            <li>Kale — verified in plant-clip retention trials</li>
          </ul>
        </div>
        <div class="card reveal-2" style="border-color:rgba(255,100,100,0.15);">
          <div class="section-label" style="color:#f87171;margin-bottom:0.75rem;">Not Suitable</div>
          <ul style="color:#94a3b8;font-size:0.875rem;line-height:2;margin:0;padding-left:1.1rem;">
            <li>Root vegetables — grow deformed without soil pressure</li>
          </ul>
        </div>
      </div>

      <!-- Works cited -->
      <details style="padding:1rem 1.25rem;border-radius:0.75rem;background:rgba(212,160,23,0.04);
                  border:1px solid rgba(212,160,23,0.12);font-size:0.825rem;color:#94a3b8;" data-reveal>
        <summary style="cursor:pointer;color:#e2e8f0;font-weight:600;">Works Cited (8)</summary>
        <ul style="margin:0.75rem 0 0;padding-left:1.1rem;line-height:1.7;">
          {[
            {"t": "LettUs Grow — Aeroponics. (n.d.). LettUs Grow.", "u": "https://www.lettusgrow.com/aeroponic-technology"},
            {"t": "Exploring The Advantages Of Aeroponics. (2024, January 29). Atlas Scientific.", "u": "https://atlas-scientific.com/blog/advantages-of-aeroponics/"},
            {"t": "MacArthur, A. (2024, February 12). 5 of the Best Plants for Aeroponic Vegetable Gardens. Food Gardening Network.", "u": "https://foodgardening.mequoda.com/daily/vegetable-gardening/best-plants-for-aeroponic-vegetable-gardens/"},
            {"t": "A Novel Approach to Growing Gardens in Space - NASA Science. (2022, February 15). Science.nasa.gov.", "u": "https://science.nasa.gov/science-research/science-enabling-technology/technology-highlights/a-novel-approach-to-growing-gardens-in-space/"},
            {"t": "Agrotonomy. (2021). Can I Grow Potatoes and Carrots on a Tower Garden? Agrotonomy.com.", "u": "https://agrotonomy.com/can-i-grow-potatoes-and-carrots-on-a-tower-garden/"},
            {"t": "NoSoilSolutions. (2014, September 19). What is Aeroponics? - NoSoilSolutions.", "u": "https://nosoilsolutions.com/aeroponics/"},
            {"t": "Dick, M. (2022, February 1). Rooting for success mid-air. Greenhouse Canada.", "u": "https://www.greenhousecanada.com/rooting-for-success-mid-air/"},
            {"t": "eXposed Root On-Orbit Test System (XROOTS) Tech Demo - NASA Science. (n.d.). Science.nasa.gov.", "u": "https://science.nasa.gov/biological-physical/investigations/xroots/"}
          ].map(r => <li>{r.t} <a href={r.u} target="_blank" rel="noopener" style="color:#d4a017;word-break:break-all;">{r.u}</a></li>)}
        </ul>
      </details>

    </div>
  </PageShell>

  <Footer slot="footer" />
</Layout>
