---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import PageShell from '../components/PageShell.astro';
---
<Layout title="Aeroponics">
  <Nav slot="nav" />

  <PageShell
    title="Aeroponics"
    subtitle="The Nanolab employs aeroponics as its primary growing method, where plants remain suspended in air — roots absorbing water directly from the hexagonal channel system."
    badge="Biology"
  >
    <div style="display:grid;gap:2.5rem;">

      <!-- Overview -->
      <div style="display:grid;grid-template-columns:1fr;gap:2rem;">
        <div>
          <h2 class="font-display" style="font-size:1.4rem;font-weight:700;color:#fff;margin:0 0 1rem;">
            How It Works in HexaFlow
          </h2>
          <p style="color:#94a3b8;line-height:1.75;margin:0 0 1rem;">
            In microgravity, plants will grow on the TDC Delivery System with roots absorbing water
            directly from the channel system. This approach avoids the complications of substrate-water
            interaction in zero gravity.
          </p>
          <p style="color:#94a3b8;line-height:1.75;margin:0 0 1rem;">
            <strong style="color:#e2e8f0;">Plant clips</strong> secure vegetation both on Earth and in space — they are
            inserted into TDC holes and grip the plant stem. To verify this works, the team inverted the
            TDC with kale threaded through both clips for one minute. Plants remained fully retained.
          </p>
          <p style="color:#94a3b8;line-height:1.75;margin:0;">
            An AI module regulates water delivery to prevent root rot. The customizable water/nutrient
            reservoir uses recycled plastic, VEX fittings, and heat-sealing technology. Its modular
            design supports various HexaFlow configurations and future expansion.
          </p>
        </div>
      </div>

      <!-- Benefits -->
      <div>
        <h2 class="font-display" style="font-size:1.4rem;font-weight:700;color:#fff;margin:0 0 1.25rem;">
          Benefits of Aeroponics
        </h2>
        <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:1rem;">
          {[
            { stat:'98%',          label:'Less Water',       desc:'Compared to traditional soil-based farming' },
            { stat:'Suspended',    label:'Root System',      desc:'Roots hang in air — maximum oxygen exposure' },
            { stat:'Accelerated',  label:'Growth Rate',      desc:'Enhanced atmospheric gas exposure (O₂, CO₂)' },
            { stat:'None',         label:'Gravity Required', desc:'System works in microgravity environments' },
          ].map(s => (
            <div class="card">
              <div class="font-display" style="font-size:1.5rem;font-weight:700;color:#d4a017;margin-bottom:0.25rem;">{s.stat}</div>
              <div style="font-weight:600;color:#fff;font-size:0.9rem;margin-bottom:0.35rem;">{s.label}</div>
              <div style="font-size:0.825rem;color:#64748b;">{s.desc}</div>
            </div>
          ))}
        </div>
      </div>

      <!-- Aeroponics photos -->
      <div>
        <h2 class="font-display" style="font-size:1.4rem;font-weight:700;color:#fff;margin:0 0 1.25rem;">
          Aeroponics Photos
        </h2>
        <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:1rem;">
          <div style="border-radius:0.75rem;overflow:hidden;border:1px solid rgba(212,160,23,0.15);">
            <img src="/images/aeroponics-1.jpg" alt="Plant clips securing kale in TDC"
                 style="width:100%;display:block;object-fit:cover;max-height:220px;" loading="lazy"/>
            <div style="padding:0.5rem 0.85rem;background:#0d1e35;font-size:0.78rem;color:#64748b;">Plant clips in TDC</div>
          </div>
          <div style="border-radius:0.75rem;overflow:hidden;border:1px solid rgba(212,160,23,0.15);">
            <img src="/images/aeroponics-2.jpg" alt="Aeroponic root system"
                 style="width:100%;display:block;object-fit:cover;max-height:220px;" loading="lazy"/>
            <div style="padding:0.5rem 0.85rem;background:#0d1e35;font-size:0.78rem;color:#64748b;">Aeroponic root system</div>
          </div>
          <div style="border-radius:0.75rem;overflow:hidden;border:1px solid rgba(212,160,23,0.15);">
            <img src="/images/aeroponics-3.jpg" alt="Reservoir and VEX fittings"
                 style="width:100%;display:block;object-fit:cover;max-height:220px;" loading="lazy"/>
            <div style="padding:0.5rem 0.85rem;background:#0d1e35;font-size:0.78rem;color:#64748b;">Reservoir assembly</div>
          </div>
          <div style="border-radius:0.75rem;overflow:hidden;border:1px solid rgba(212,160,23,0.15);">
            <img src="/images/aeroponics-4.jpg" alt="Inversion test — kale retained"
                 style="width:100%;display:block;object-fit:cover;max-height:220px;" loading="lazy"/>
            <div style="padding:0.5rem 0.85rem;background:#0d1e35;font-size:0.78rem;color:#64748b;">Inversion test</div>
          </div>
        </div>
      </div>

      <!-- Suitable crops -->
      <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(300px,1fr));gap:1.5rem;">
        <div class="card">
          <div class="section-label" style="margin-bottom:0.75rem;">Suitable Crops</div>
          <ul style="color:#94a3b8;font-size:0.875rem;line-height:2;margin:0;padding-left:1.1rem;">
            <li>Leafy greens</li>
            <li>Vegetables</li>
            <li>Small flowering plants</li>
            <li>Kale (tested in plant clip trials)</li>
          </ul>
        </div>
        <div class="card" style="border-color:rgba(255,100,100,0.15);">
          <div class="section-label" style="color:#f87171;margin-bottom:0.75rem;">Not Suitable</div>
          <ul style="color:#94a3b8;font-size:0.875rem;line-height:2;margin:0;padding-left:1.1rem;">
            <li>Root vegetables (grow deformed without soil pressure)</li>
          </ul>
        </div>
      </div>

      <!-- Space programs -->
      <div>
        <h2 class="font-display" style="font-size:1.4rem;font-weight:700;color:#fff;margin:0 0 1.25rem;">
          Space Aeroponics Programs
        </h2>
        <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(260px,1fr));gap:1rem;">
          {[
            {
              org:'China',
              program:'Lunar Farming Program',
              desc:'Integrated aeroponics into lunar agriculture experiments, demonstrating viability in space environments.',
            },
            {
              org:'Sierra Space',
              program:'Astro Garden (XROOTS)',
              desc:'eXposed Root On-Orbit Test System — developing aeroponic plant cultivation for long-duration spaceflight.',
            },
          ].map(p => (
            <div class="card">
              <div class="section-label" style="margin-bottom:0.4rem;">{p.org}</div>
              <h3 class="font-display" style="font-size:1rem;font-weight:700;color:#fff;margin:0 0 0.5rem;">{p.program}</h3>
              <p style="font-size:0.85rem;color:#64748b;line-height:1.6;margin:0;">{p.desc}</p>
            </div>
          ))}
        </div>
      </div>

      <!-- Works cited -->
      <div style="padding:1.25rem;border-radius:0.75rem;background:rgba(212,160,23,0.04);
                  border:1px solid rgba(212,160,23,0.12);">
        <div class="font-display" style="font-weight:700;color:#fff;margin-bottom:0.5rem;">Works Cited</div>
        <div style="font-size:0.825rem;color:#64748b;line-height:1.8;">
          LettUs Grow · Atlas Scientific · Food Gardening Network · NASA Science ·
          Agrotonomy · NoSoilSolutions · Greenhouse Canada · NASA XROOTS Program Documentation
        </div>
        <a href="/sources" style="font-size:0.825rem;color:#d4a017;text-decoration:none;margin-top:0.5rem;display:inline-block;">
          View full sources list →
        </a>
      </div>

    </div>
  </PageShell>

  <Footer slot="footer" />
</Layout>
