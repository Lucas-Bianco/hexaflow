---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import PageShell from '../components/PageShell.astro';

const components = [
  {
    name: 'Nanolab Enclosure',
    desc: 'The outer shell houses a sliding shelf system for electronic plates, lights, and the experiment module. Hollow side walls route cables while keeping electronics dry.',
  },
  {
    name: 'TDC (Thorny Devil Capillary System)',
    desc: 'The core experiment module — a hexagonal lattice that uses capillary action to distribute water evenly throughout the interior. Hex channels are 0.48 mm across, spaced 0.51 mm apart, to optimize distribution.',
  },
  {
    name: 'TDC V2',
    desc: 'A refined iteration that pairs resin construction with 3D-printed framing. It cuts weight and manufacturing cost while opening a camera viewport for monitoring the pump and reservoir.',
  },
  {
    name: 'Camera/LED Mounting Module',
    desc: 'Mounts the camera and LED lighting above the root zone, with an anti-glare strip to suppress lens flare during imaging.',
  },
  {
    name: 'Plant Clips',
    desc: 'Friction-fit holders that slip between hexagon gaps and clamp around the plant stem. Tested successfully under a 1-minute inversion with kale.',
  },
  {
    name: 'Water Injector',
    desc: 'Mounted at the system base for hemisphere entry. It delivers precise water introduction into the channel network, and the injector hole can be sealed during drop tests.',
  },
  {
    name: 'Pump Adapter',
    desc: 'An interface piece compatible with both the high-capacity drop-test pump and the long-term precision pump — one enclosure, two configurations.',
  },
  {
    name: 'Front & Side Door Panels',
    desc: 'Access panels for internal components and the experiment module slot. They allow rapid module swaps without full disassembly.',
  },
  {
    name: 'Substrate Covers (Rockwool)',
    desc: 'Custom covers for the rockwool substrate tray, with openings sized for moisture-sensor probes. They keep substrate contained during inversion tests.',
  },
  {
    name: 'Clay Pebble Grates',
    desc: 'Mesh grates hold clay pebbles in place during microgravity — preventing substrate migration while letting water and roots pass through.',
  },
  {
    name: 'USB Camera Clip (Reservoir)',
    desc: 'A clip that mounts a USB camera to monitor the pump and reservoir, separate from the primary root-zone camera.',
  },
];
---
<Layout title="CAD Drawings + Photos">
  <Nav slot="nav" />

  <PageShell
    title="CAD Drawings + Photos"
    subtitle="Technical component designs combining resin construction, SLA printing, and 3D-printed framing — every part engineered for the nanolab's modular architecture."
    badge="Documentation"
  >
    <div style="display:grid;gap:2.5rem;">

      <!-- Component descriptions -->
      <div data-reveal>
        <h2 class="font-display" style="font-size:1.4rem;font-weight:700;color:#fff;margin:0 0 1.25rem;">
          Custom Components, Built In-House
        </h2>
        <div style="display:grid;gap:0.85rem;">
          {components.map((c, i) => (
            <div class={`card reveal reveal-${Math.min(i + 1, 6)}`} data-reveal style="display:grid;grid-template-columns:auto 1fr;gap:1.25rem;align-items:start;">
              <div style="width:32px;height:32px;border-radius:0.375rem;background:rgba(212,160,23,0.1);
                           border:1px solid rgba(212,160,23,0.25);display:flex;align-items:center;
                           justify-content:center;font-size:0.8rem;font-weight:700;color:#d4a017;
                           font-family:'Space Grotesk',sans-serif;flex-shrink:0;">
                {String(i+1).padStart(2,'0')}
              </div>
              <div>
                <div class="font-display" style="font-weight:700;color:#fff;margin-bottom:0.3rem;">{c.name}</div>
                <div style="font-size:0.875rem;color:#64748b;line-height:1.65;">{c.desc}</div>
              </div>
            </div>
          ))}
        </div>
      </div>

      <!-- CAD photo gallery -->
      <div data-reveal>
        <h2 class="font-display kinetic" data-kinetic="word" data-reveal style="font-size:1.4rem;font-weight:700;color:#fff;margin:0 0 0.75rem;">
          Renderings &amp; Photos
        </h2>
        <div class="cad-grid">
          {[
            { src:'/images/cad-1.jpg',  caption:'Nanolab enclosure' },
            { src:'/images/cad-2.jpg',  caption:'TDC top view' },
            { src:'/images/cad-3.jpg',  caption:'TDC V2' },
            { src:'/images/cad-4.jpg',  caption:'Plant clip detail' },
            { src:'/images/cad-5.jpg',  caption:'Pump adapter' },
            { src:'/images/cad-6.jpg',  caption:'Substrate cover' },
            { src:'/images/cad-7.jpg',  caption:'Full assembly' },
            { src:'/images/cad-8.jpg',  caption:'Camera/LED mount' },
            { src:'/images/cad-9.jpg',  caption:'Water injector' },
            { src:'/images/cad-10.jpg', caption:'Front door panel' },
            { src:'/images/cad-11.jpg', caption:'Side door panel' },
            { src:'/images/cad-12.jpg', caption:'Clay pebble grate' },
            { src:'/images/cad-13.jpg', caption:'USB camera clip' },
            { src:'/images/cad-14.jpg', caption:'Reservoir fittings' },
            { src:'/images/cad-15.jpg', caption:'CAD drawing 15' },
            { src:'/images/cad-16.jpg', caption:'CAD drawing 16' },
            { src:'/images/cad-17.jpg', caption:'CAD drawing 17' },
            { src:'/images/cad-18.jpg', caption:'CAD drawing 18' },
            { src:'/images/cad-19.jpg', caption:'CAD drawing 19' },
            { src:'/images/cad-20.jpg', caption:'CAD drawing 20' },
            { src:'/images/cad-21.jpg', caption:'CAD drawing 21' },
            { src:'/images/cad-22.jpg', caption:'CAD drawing 22' },
            { src:'/images/cad-23.jpg', caption:'CAD drawing 23' },
            { src:'/images/cad-24.jpg', caption:'CAD drawing 24' },
            { src:'/images/cad-25.jpg', caption:'CAD drawing 25' },
            { src:'/images/cad-26.jpg', caption:'CAD drawing 26' },
          ].map((p, i) => (
            [0, 2, 6, 8].includes(i) ? (
              <figure class="depth-fig featured" data-reveal>
                <div class="df-glow" data-layer="far" aria-hidden="true"></div>
                <img class="df-img" data-layer="mid" src={p.src} alt={p.caption} loading="lazy" />
                <div class="df-hex" data-layer="near" aria-hidden="true"></div>
                <figcaption class="gi-caption">{p.caption}</figcaption>
              </figure>
            ) : (
              <div class={`gi reveal reveal-${(i % 6) + 1}`} data-reveal>
                <img src={p.src} alt={p.caption} loading="lazy"/>
                <div class="gi-caption">{p.caption}</div>
              </div>
            )
          ))}
        </div>
      </div>

    </div>
  </PageShell>

  <Footer slot="footer" />
</Layout>

<style>
  .cad-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
    gap: 1rem;
  }
  .gi {
    border-radius: 0.75rem;
    overflow: hidden;
    border: 1px solid var(--hex-line);
  }
  .gi img {
    width: 100%;
    display: block;
    object-fit: cover;
    max-height: 180px;
  }
  .gi-caption {
    padding: 0.4rem 0.75rem;
    background: var(--hex-card);
    font-size: 0.75rem;
    color: var(--hex-muted-2);
  }
  /* DepthFigure hero items — span 2 columns and crop taller for prominence */
  .depth-fig.featured {
    grid-column: span 2;
  }
  .depth-fig.featured .df-img {
    height: 280px;
    object-fit: cover;
  }
  @media (max-width: 560px) {
    .depth-fig.featured { grid-column: span 2; }
  }
</style>
