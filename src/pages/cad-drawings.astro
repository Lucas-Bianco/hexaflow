---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import PageShell from '../components/PageShell.astro';

const components = [
  {
    name: 'Nanolab Enclosure',
    desc: 'The outer shell houses a sliding shelf system for electronic plates, lights, and the experiment module. Hollow side walls route cables while keeping electronics dry.',
  },
  {
    name: 'TDC (Thorny Devil Capillary System)',
    desc: 'The core experiment module — a hexagonal lattice that uses capillary action to distribute water evenly throughout the interior. Hexagons are spaced 0.020 in (0.51 mm) apart to form the capillary channels.',
  },
  {
    name: 'TDC V2',
    desc: 'A refined iteration that pairs resin construction with 3D-printed framing. It cuts weight and manufacturing cost, makes room for cameras on the inside, and gives a camera a view of the pump and reservoir in the bottom half.',
  },
  {
    name: 'Camera/LED Mounting Module',
    desc: 'Holds the camera and anti-glare lighting, and slides into the shell with an opening for viewing the plant.',
  },
  {
    name: 'Plant Clips',
    desc: 'Friction-fit holders that slip between hexagon gaps and clamp around the plant stem. Tested successfully under a 1-minute inversion with kale.',
  },
  {
    name: 'Water Injector',
    desc: 'The entry point for water into the system, at the base of the TDC. The injector hole was plugged for the balcony drop tests.',
  },
  {
    name: 'Pump Adapter',
    desc: 'Lets the faster drop-test pump fit the slot designed for the slower long-term pump — one enclosure, two configurations.',
  },
  {
    name: 'Front & Side Door Panels',
    desc: 'A tabbed front door for easy maintenance, and side doors that cover the wire access in the hollow shell walls.',
  },
  {
    name: 'Substrate Covers (Rockwool)',
    desc: 'Custom covers for the rockwool substrate tray, with openings sized for moisture-sensor probes. They keep substrate contained during inversion tests.',
  },
  {
    name: 'Clay Pebble Grates',
    desc: 'A containment grate that holds clay pebbles in place for microgravity experiments, with an opening for the moisture sensor.',
  },
  {
    name: 'Camera Clip',
    desc: 'A ball-and-socket attachment for a USB camera that monitors the pump and reservoir.',
  },
];
---
<Layout title="CAD Drawings + Photos">
  <Nav slot="nav" />

  <PageShell
    title="CAD Drawings + Photos"
    subtitle="Technical component designs combining resin construction, SLA printing, and 3D-printed framing — every part engineered for the nanolab's modular architecture."
    badge="Documentation"
  >
    <div style="display:grid;gap:2.5rem;">

      <!-- Component descriptions -->
      <div data-reveal>
        <h2 class="font-display" style="font-size:1.4rem;font-weight:700;color:#fff;margin:0 0 1.25rem;">
          Custom Components, Built In-House
        </h2>
        <div style="display:grid;gap:0.85rem;">
          {components.map((c, i) => (
            <div class={`card reveal reveal-${Math.min(i + 1, 6)}`} data-reveal style="display:grid;grid-template-columns:auto 1fr;gap:1.25rem;align-items:start;">
              <div style="width:32px;height:32px;border-radius:0.375rem;background:rgba(212,160,23,0.1);
                           border:1px solid rgba(212,160,23,0.25);display:flex;align-items:center;
                           justify-content:center;font-size:0.8rem;font-weight:700;color:#d4a017;
                           font-family:'Space Grotesk',sans-serif;flex-shrink:0;">
                {String(i+1).padStart(2,'0')}
              </div>
              <div>
                <div class="font-display" style="font-weight:700;color:#fff;margin-bottom:0.3rem;">{c.name}</div>
                <div style="font-size:0.875rem;color:#64748b;line-height:1.65;">{c.desc}</div>
              </div>
            </div>
          ))}
        </div>
      </div>

      <!-- CAD photo gallery -->
      <div data-reveal>
        <h2 class="font-display kinetic" data-kinetic="word" data-reveal style="font-size:1.4rem;font-weight:700;color:#fff;margin:0 0 0.75rem;">
          Renderings &amp; Photos
        </h2>
        <div class="cad-grid">
          {[
            { src:'/images/cad-1.jpg',  caption:'HexaFlow V2 assembly drawing' },
            { src:'/images/cad-2.jpg',  caption:'Exterior enclosure drawing' },
            { src:'/images/cad-3.jpg',  caption:'Exterior enclosure (printed)' },
            { src:'/images/cad-4.jpg',  caption:'TDC V2 top drawing' },
            { src:'/images/cad-5.jpg',  caption:'TDC V2 top (printed)' },
            { src:'/images/cad-6.jpg',  caption:'TDC V2 bottom half drawing' },
            { src:'/images/cad-7.jpg',  caption:'TDC V2 assembled' },
            { src:'/images/cad-8.jpg',  caption:'Camera & LED module drawing' },
            { src:'/images/cad-9.jpg',  caption:'Camera & LED module (printed)' },
            { src:'/images/cad-10.jpg', caption:'Plant clip V2 drawing' },
            { src:'/images/cad-11.jpg', caption:'Plant clip V2 (printed)' },
            { src:'/images/cad-12.jpg', caption:'Water injector drawing' },
            { src:'/images/cad-13.jpg', caption:'Water injector (printed)' },
            { src:'/images/cad-14.jpg', caption:'Pump adapter drawing' },
            { src:'/images/cad-15.jpg', caption:'Pump adapter (printed)' },
            { src:'/images/cad-16.jpg', caption:'Enclosure front door drawing' },
            { src:'/images/cad-17.jpg', caption:'Enclosure back door drawing' },
            { src:'/images/cad-18.jpg', caption:'Side enclosure door drawing' },
            { src:'/images/cad-19.jpg', caption:'Front door (printed)' },
            { src:'/images/cad-20.jpg', caption:'Side door (printed)' },
            { src:'/images/cad-21.jpg', caption:'Rockwool substrate holder drawing' },
            { src:'/images/cad-22.jpg', caption:'Rockwool substrate holder installed' },
            { src:'/images/cad-23.jpg', caption:'Clay substrate grate drawing' },
            { src:'/images/cad-24.jpg', caption:'Clay substrate grate installed' },
            { src:'/images/cad-25.jpg', caption:'Ball + socket camera holder drawing' },
            { src:'/images/cad-26.jpg', caption:'Ball + socket camera holder (printed)' },
          ].map((p, i) => (
            [0, 2, 6, 8].includes(i) ? (
              <figure class="depth-fig featured" data-reveal>
                <div class="df-glow" data-layer="far" aria-hidden="true"></div>
                <img class="df-img" data-layer="mid" src={p.src} alt={p.caption} loading="lazy" />
                <div class="df-hex" data-layer="near" aria-hidden="true"></div>
                <figcaption class="gi-caption">{p.caption}</figcaption>
              </figure>
            ) : (
              <div class={`gi reveal reveal-${(i % 6) + 1}`} data-reveal>
                <img src={p.src} alt={p.caption} loading="lazy"/>
                <div class="gi-caption">{p.caption}</div>
              </div>
            )
          ))}
        </div>
      </div>

    </div>
  </PageShell>

  <Footer slot="footer" />
</Layout>

<style>
  .cad-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
    gap: 1rem;
  }
  .gi {
    border-radius: 0.75rem;
    overflow: hidden;
    border: 1px solid var(--hex-line);
  }
  .gi img {
    width: 100%;
    display: block;
    object-fit: cover;
    max-height: 180px;
  }
  .gi-caption {
    padding: 0.4rem 0.75rem;
    background: var(--hex-card);
    font-size: 0.75rem;
    color: var(--hex-muted-2);
  }
  /* DepthFigure hero items — span 2 columns and crop taller for prominence */
  .depth-fig.featured {
    grid-column: span 2;
  }
  .depth-fig.featured .df-img {
    height: 280px;
    object-fit: cover;
  }
  @media (max-width: 560px) {
    .depth-fig.featured { grid-column: span 2; }
  }
</style>
