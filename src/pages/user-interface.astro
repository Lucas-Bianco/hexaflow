---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import PageShell from '../components/PageShell.astro';
---
<Layout title="User Interface">
  <Nav slot="nav" />

  <PageShell
    title="User Interface"
    subtitle="A locally-networked dashboard giving operators real-time monitoring, graphing, photo galleries, and full system control — designed to work on any device aspect ratio."
    badge="Software"
  >
    <div style="display:grid;gap:2.5rem;">

      <!-- Overview -->
      <div>
        <h2 class="font-display" style="font-size:1.4rem;font-weight:700;color:#fff;margin:0 0 1rem;">
          Development &amp; Version Control
        </h2>
        <p style="color:#94a3b8;line-height:1.75;margin:0 0 1rem;">
          The team prioritized version control using GitHub, recognizing that major revisions would
          occur throughout development. GitHub enables incremental tracking and explanatory commit
          messages for organized UI development.
        </p>
        <a href="https://github.com/AidanForrester/TC-HUNCH-Nanolab"
           target="_blank" rel="noopener"
           style="display:inline-flex;align-items:center;gap:0.6rem;padding:0.6rem 1.25rem;
                  border-radius:0.5rem;font-size:0.875rem;font-weight:600;text-decoration:none;
                  color:#fff;background:#0d1e35;border:1px solid rgba(212,160,23,0.25);
                  transition:border-color 0.15s;"
           onmouseover="this.style.borderColor='rgba(212,160,23,0.6)'"
           onmouseout="this.style.borderColor='rgba(212,160,23,0.25)'">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="#94a3b8">
            <path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0 0 24 12c0-6.63-5.37-12-12-12z"/>
          </svg>
          AidanForrester/TC-HUNCH-Nanolab
        </a>
      </div>

      <!-- Features -->
      <div>
        <h2 class="font-display" style="font-size:1.4rem;font-weight:700;color:#fff;margin:0 0 1.25rem;">
          Core UI Capabilities
        </h2>
        <p style="color:#94a3b8;font-size:0.9rem;margin:0 0 1.25rem;">
          The interface is accessible via local network and offers the following functions:
        </p>
        <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(240px,1fr));gap:1rem;">
          {[
            {
              title:'Live Camera Feed',
              desc:'Real-time monitoring with sensor and AI readouts displayed alongside the camera view. Supports swappable camera views.',
            },
            {
              title:'Real-Time Graphing',
              desc:'Live-updating graphs with comparison functionality. Data is downloadable in both JSON and PNG formats.',
            },
            {
              title:'Photo Galleries',
              desc:'Automatic photo capture at 6-hour intervals during plant growth, plus rapid captures during drop tests.',
            },
            {
              title:'Quick-Access Buttons',
              desc:'One-click controls for lighting modes, on-demand photo capture, and test initiation.',
            },
            {
              title:'Configurable Settings',
              desc:'Substrate type, photo frequency, light brightness, and sensor parameters are all adjustable from the interface.',
            },
            {
              title:'All Aspect Ratios',
              desc:"Device specs for astronaut hardware were unknown, so the interface was designed to work on any screen size.",
            },
          ].map(f => (
            <div class="card">
              <h3 class="font-display" style="font-size:0.95rem;font-weight:700;color:#fff;margin:0 0 0.5rem;">{f.title}</h3>
              <p style="font-size:0.85rem;color:#64748b;line-height:1.6;margin:0;">{f.desc}</p>
            </div>
          ))}
        </div>
      </div>

      <!-- UI screenshot -->
      <div>
        <h2 class="font-display" style="font-size:1.4rem;font-weight:700;color:#fff;margin:0 0 1.25rem;">
          Interface Screenshot
        </h2>
        <div style="border-radius:0.75rem;overflow:hidden;border:1px solid rgba(212,160,23,0.15);">
          <img src="/images/ui-1.jpg" alt="HexaFlow user interface dashboard screenshot"
               style="width:100%;display:block;object-fit:cover;" loading="lazy"/>
          <div style="padding:0.6rem 1rem;background:#0d1e35;font-size:0.78rem;color:#64748b;">
            HexaFlow UI dashboard — live camera feed, graphing, and controls
          </div>
        </div>
      </div>

      <!-- Video placeholder -->
      <div>
        <h2 class="font-display" style="font-size:1.4rem;font-weight:700;color:#fff;margin:0 0 1.25rem;">
          Interface Demo Video
        </h2>
        <div class="card" style="display:flex;flex-direction:column;align-items:center;
                                  justify-content:center;min-height:220px;gap:1rem;text-align:center;">
          <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="#d4a017" stroke-width="1.5">
            <circle cx="12" cy="12" r="10"/>
            <polygon points="10,8 16,12 10,16" fill="#d4a017" stroke="none"/>
          </svg>
          <div>
            <div class="font-display" style="font-weight:700;color:#fff;margin-bottom:0.35rem;">V2UI.mp4</div>
            <div style="font-size:0.85rem;color:#64748b;">
              Drop <code style="color:#d4a017;">V2UI.mp4</code> into <code style="color:#d4a017;">public/images/</code> to enable video playback.
            </div>
          </div>
        </div>
      </div>

    </div>
  </PageShell>

  <Footer slot="footer" />
</Layout>
