---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import PageShell from '../components/PageShell.astro';
---
<Layout title="Modular Enclosure">
  <Nav slot="nav" />

  <PageShell
    title="Modular Enclosure"
    subtitle="A sliding shelf system for electronics, lights, and the experiment module — with two distinct configurations for drop testing and long-term plant growth."
    badge="Hardware"
  >
    <div style="display:grid;gap:2.5rem;">

      <!-- Two configs -->
      <div data-reveal>
        <h2 class="font-display kinetic" data-kinetic="word" data-reveal style="font-size:1.4rem;font-weight:700;color:#fff;margin:0 0 1.25rem;">
          Two Configurations
        </h2>
        <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(280px,1fr));gap:1.25rem;">

          <!-- Drop Test -->
          <div class="card reveal-1" style="border-color:rgba(212,160,23,0.35);">
            <div class="section-label" style="margin-bottom:0.75rem;">Configuration A</div>
            <h3 class="font-display" style="font-size:1.15rem;font-weight:700;color:#fff;margin:0 0 1rem;">
              Drop Test Setup
            </h3>
            <ul style="color:#94a3b8;font-size:0.875rem;line-height:1.9;margin:0;padding-left:1.1rem;">
              <li>No TDS or pH sensors (removed for weight/space)</li>
              <li>Larger, high-capacity pump installed</li>
              <li>Target: <strong style="color:#e2e8f0;">≈ 10.81 mL</strong> channel fill</li>
              <li>Fills channels as much as possible during <strong style="color:#e2e8f0;">5.18s</strong> drop window</li>
              <li>Optimized for short-duration data collection</li>
            </ul>
          </div>

          <!-- Long-term -->
          <div class="card reveal-2">
            <div class="section-label" style="margin-bottom:0.75rem;">Configuration B</div>
            <h3 class="font-display" style="font-size:1.15rem;font-weight:700;color:#fff;margin:0 0 1rem;">
              Long-Term Growing Setup
            </h3>
            <ul style="color:#94a3b8;font-size:0.875rem;line-height:1.9;margin:0;padding-left:1.1rem;">
              <li>TDS (Total Dissolved Solids) sensor included</li>
              <li>pH sensor included</li>
              <li>Larger reservoir for extended growing sessions</li>
              <li>Smaller, precise pump (320mA savings over drop test pump)</li>
              <li>Fine-grain water delivery tuning</li>
              <li>AI actively monitors and controls watering</li>
            </ul>
          </div>
        </div>
      </div>

      <!-- Enclosure design -->
      <div data-reveal>
        <h2 class="font-display" style="font-size:1.4rem;font-weight:700;color:#fff;margin:0 0 1.25rem;">
          Enclosure Design
        </h2>
        <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:1rem;">
          {[
            { title:'Sliding Shelf System', desc:'Electronics, lights, and the experiment module all mount to a sliding rail — hot-swappable without tools.' },
            { title:'Hollow Side Walls',    desc:'Cable management runs through hollow walls, protecting electronics from water exposure.' },
            { title:'Front & Side Doors',   desc:'Panel doors provide easy access to internal components and the experiment module.' },
            { title:'Modular Slots',        desc:'The experiment module slot accepts the TDC (capillary plate), substrate tray, or future experiment types.' },
          ].map((f, i) => (
            <div class={`card reveal-${i + 1}`}>
              <h3 class="font-display" style="font-size:0.95rem;font-weight:700;color:#d4a017;margin:0 0 0.5rem;">{f.title}</h3>
              <p style="font-size:0.85rem;color:#64748b;line-height:1.6;margin:0;">{f.desc}</p>
            </div>
          ))}
        </div>
      </div>

      <!-- Enclosure diagram (SVG) -->
      <section class="pin">
        <header class="pin-head">
          <div class="section-label">Hardware</div>
          <h2 class="font-display" data-reveal style="font-size:1.4rem;font-weight:700;color:#fff;margin:0 0 1.25rem;">
            Enclosure Diagram
          </h2>
        </header>
        <div class="pin-body" data-reveal>
        <div class="card" style="display:flex;justify-content:center;padding:2rem;">
          <svg width="100%" viewBox="0 0 380 260" style="max-width:480px;" xmlns="http://www.w3.org/2000/svg">
            <!-- Outer enclosure -->
            <rect x="20" y="20" width="340" height="220" rx="8"
                  fill="rgba(212,160,23,0.05)" stroke="#d4a017" stroke-width="2"/>
            <!-- Side walls (hollow indicator) -->
            <rect x="20" y="20" width="28" height="220" rx="8"
                  fill="rgba(212,160,23,0.08)" stroke="rgba(212,160,23,0.3)" stroke-width="1"/>
            <rect x="332" y="20" width="28" height="220" rx="8"
                  fill="rgba(212,160,23,0.08)" stroke="rgba(212,160,23,0.3)" stroke-width="1"/>
            <text x="34" y="135" fill="#64748b" font-size="8" font-family="Inter,sans-serif"
                  transform="rotate(-90,34,135)">Cable</text>
            <text x="346" y="135" fill="#64748b" font-size="8" font-family="Inter,sans-serif"
                  transform="rotate(90,346,135)">Cable</text>

            <!-- Sliding shelf rails -->
            <line x1="48" y1="90" x2="332" y2="90" stroke="rgba(212,160,23,0.4)" stroke-width="1.5" stroke-dasharray="4 3"/>
            <line x1="48" y1="160" x2="332" y2="160" stroke="rgba(212,160,23,0.4)" stroke-width="1.5" stroke-dasharray="4 3"/>
            <text x="190" y="86" text-anchor="middle" fill="#64748b" font-size="8" font-family="Inter,sans-serif">shelf rail</text>
            <text x="190" y="156" text-anchor="middle" fill="#64748b" font-size="8" font-family="Inter,sans-serif">shelf rail</text>

            <!-- Electronics shelf -->
            <rect x="60" y="95" width="260" height="55" rx="4"
                  fill="rgba(212,160,23,0.08)" stroke="rgba(212,160,23,0.3)" stroke-width="1"/>
            <text x="190" y="119" text-anchor="middle" fill="#94a3b8" font-size="10"
                  font-family="Space Grotesk,sans-serif" font-weight="600">Electronics + Carrier Board</text>
            <text x="190" y="134" text-anchor="middle" fill="#64748b" font-size="8"
                  font-family="Inter,sans-serif">RPi · USB hub · pump</text>

            <!-- Experiment module -->
            <rect x="60" y="168" width="260" height="55" rx="4"
                  fill="rgba(212,160,23,0.12)" stroke="#d4a017" stroke-width="1.5"/>
            <text x="190" y="192" text-anchor="middle" fill="#fff" font-size="10"
                  font-family="Space Grotesk,sans-serif" font-weight="600">Experiment Module (TDC)</text>
            <text x="190" y="207" text-anchor="middle" fill="#64748b" font-size="8"
                  font-family="Inter,sans-serif">hex channels · plant clips · substrate</text>

            <!-- LED / Camera -->
            <rect x="60" y="30" width="120" height="48" rx="4"
                  fill="rgba(103,232,249,0.06)" stroke="rgba(103,232,249,0.3)" stroke-width="1"/>
            <text x="120" y="50" text-anchor="middle" fill="#93c5fd" font-size="9"
                  font-family="Space Grotesk,sans-serif" font-weight="600">Camera/LED</text>
            <text x="120" y="65" text-anchor="middle" fill="#64748b" font-size="8"
                  font-family="Inter,sans-serif">anti-glare strip</text>

            <!-- Reservoir -->
            <rect x="200" y="30" width="120" height="48" rx="4"
                  fill="rgba(212,160,23,0.06)" stroke="rgba(212,160,23,0.25)" stroke-width="1"/>
            <text x="260" y="50" text-anchor="middle" fill="#94a3b8" font-size="9"
                  font-family="Space Grotesk,sans-serif" font-weight="600">Reservoir</text>
            <text x="260" y="65" text-anchor="middle" fill="#64748b" font-size="8"
                  font-family="Inter,sans-serif">VEX fittings · heat seal</text>

            <!-- Arrows/labels -->
            <text x="190" y="252" text-anchor="middle" fill="#475569" font-size="9"
                  font-family="Inter,sans-serif">← sliding shelf direction</text>
          </svg>
        </div>
        <p style="font-size:0.8rem;color:#64748b;margin-top:0.75rem;text-align:center;">
          Enclosure diagram showing shelf system, cable management walls, electronics, and experiment module positions.
          Add the actual enclosure diagram photo when available.
        </p>
        </div>
    </section>

      <!-- Enclosure photo -->
      <div style="border-radius:0.75rem;overflow:hidden;border:1px solid rgba(212,160,23,0.15);" data-reveal>
        <figure class="depth-fig">
          <div class="df-glow" data-layer="far" aria-hidden="true"></div>
          <img class="df-img" data-layer="mid" src="/images/enclosure-1.jpg" alt="HexaFlow modular enclosure — full assembly" loading="lazy"/>
          <div class="df-hex" data-layer="near" aria-hidden="true"></div>
        </figure>
        <div style="padding:0.6rem 1rem;background:#0d1e35;font-size:0.78rem;color:#64748b;">
          Modular enclosure — sliding shelf system with electronics, lights, and experiment module
        </div>
      </div>

    </div>
  </PageShell>

  <Footer slot="footer" />
</Layout>
