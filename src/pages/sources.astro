---
<Layout title="Sources">
  <Nav slot="nav" />

  <PageShell
    title="Sources"
    subtitle="Research references cited across the HexaFlow project."
    badge="References"
  >
    <div style="display:grid;gap:2.5rem;">
      <div>
        <h2 class="font-display" style="font-size:1.25rem;font-weight:700;color:#fff;margin:0 0 1rem;
                    display:flex;align-items:center;gap:0.75rem;">
          <span style="display:inline-block;width:4px;height:1.25rem;background:#d4a017;border-radius:2px;flex-shrink:0;"></span>
          <span class="kinetic" data-kinetic="word" data-reveal>Works Cited</span>
        </h2>
        <div class="refs-grid" data-reveal style="display:grid;gap:0.6rem;">
          {refs.map(r => (
            <a class="card" href={r.url} target="_blank" rel="noopener" style="padding:1rem 1.25rem;text-decoration:none;display:block;">
              <div style="font-weight:600;color:#e2e8f0;font-size:0.9rem;margin-bottom:0.25rem;">{r.title}</div>
              <div style="font-size:0.75rem;color:#64748b;">{new URL(r.url).hostname.replace(/^www\./,'')}</div>
            </a>
          ))}
        </div>
      </div>

      <p data-reveal style="font-size:0.875rem;color:#64748b;margin:0;line-height:1.65;">
        Substrate-specific references are listed on the <a href="/secondary-substrates" style="color:#d4a017;">Secondary Substrates</a> page.
      </p>
    </div>
  </PageShell>

  <Footer slot="footer" />
</Layout>

<style>
  /* Opacity-only stagger so we never fight the .card hover-lift transform. */
  .refs-grid > .card { opacity: 1; }
  .refs-grid.is-in > .card { opacity: 1; }
  .refs-grid.is-in > .card:nth-child(2) { transition-delay: .08s; }
  .refs-grid.is-in > .card:nth-child(3) { transition-delay: .16s; }
  .refs-grid.is-in > .card:nth-child(4) { transition-delay: .24s; }
  .refs-grid.is-in > .card:nth-child(5) { transition-delay: .32s; }
  .refs-grid.is-in > .card:nth-child(6) { transition-delay: .40s; }
  .refs-grid.is-in > .card:nth-child(7) { transition-delay: .48s; }
  .refs-grid.is-in > .card:nth-child(8) { transition-delay: .56s; }
  @media (prefers-reduced-motion: reduce) {
    .refs-grid > .card { opacity: 1 !important; }
  }
</style>
