---
// Reusable slideshow photo scroller + click-to-fullscreen lightbox.
// Usage: <PhotoGallery photos={[{ src, caption }]} />
interface Photo { src: string; caption?: string; }
const { photos }: { photos: Photo[] } = Astro.props;
---

<section class="pg" data-pg>
  <div class="pg-frame">
    <button class="pg-nav pg-prev" type="button" aria-label="Previous photo">‹</button>
    <div class="pg-viewport">
      <div class="pg-track" data-pg-track>
        {photos.map((p, i) => (
          <div class="pg-slide" data-cap={p.caption || ''} data-index={i}>
            <img class="pg-img" src={p.src} alt={p.caption || `Photo ${i + 1}`}
                 loading={i < 2 ? 'eager' : 'lazy'} draggable="false" />
          </div>
        ))}
      </div>
    </div>
    <button class="pg-nav pg-next" type="button" aria-label="Next photo">›</button>
  </div>

  <div class="pg-bar">
    <div class="pg-counter"><span class="pg-cur" data-pg-cur>1</span> / {photos.length}</div>
    <div class="pg-dots" data-pg-dots>
      {photos.map((_, i) => <button class="pg-dot" type="button" data-index={i} aria-label={`Go to photo ${i + 1}`}></button>)}
    </div>
    <div class="pg-cap" data-pg-cap>{photos[0]?.caption || ''}</div>
  </div>

  <!-- Click-to-fullscreen lightbox -->
  <div class="pg-lb" data-pg-lb hidden role="dialog" aria-modal="true" aria-label="Photo viewer">
    <button class="pg-lb-close" type="button" aria-label="Close">✕</button>
    <button class="pg-lb-nav pg-lb-prev" type="button" aria-label="Previous">‹</button>
    <figure class="pg-lb-figure">
      <img class="pg-lb-img" alt="" />
      <figcaption class="pg-lb-cap" data-pg-lb-cap></figcaption>
    </figure>
    <button class="pg-lb-nav pg-lb-next" type="button" aria-label="Next">›</button>
  </div>
</section>

<style>
  .pg { width: 100%; }
  .pg-frame { display: flex; align-items: center; gap: .75rem; }
  .pg-viewport { flex: 1; overflow: hidden; border-radius: .85rem;
    border: 1px solid var(--hex-line); background: var(--hex-surface); }
  .pg-track { display: flex; overflow-x: auto; scroll-snap-type: x mandatory;
    scrollbar-width: none; -ms-overflow-style: none; }
  .pg-track::-webkit-scrollbar { display: none; }
  .pg-slide { flex: 0 0 100%; min-width: 100%; scroll-snap-align: start;
    display: flex; align-items: center; justify-content: center; }
  .pg-img { display: block; width: 100%; max-height: 62vh; object-fit: contain;
    background: #04080f; cursor: zoom-in; }

  .pg-nav { flex-shrink: 0; width: 2.6rem; height: 2.6rem; border-radius: 50%;
    background: var(--hex-card); border: 1px solid var(--hex-line-2); color: var(--hex-gold);
    font-size: 1.6rem; line-height: 1; cursor: pointer; transition: background .15s, transform .12s;
    display: grid; place-items: center; }
  .pg-nav:hover { background: var(--hex-card-2); transform: scale(1.06); }
  .pg-nav:active { transform: scale(.96); }

  .pg-bar { display: flex; flex-direction: column; align-items: center; gap: .5rem;
    margin-top: .85rem; }
  .pg-counter { font: 600 .8rem 'Space Grotesk', sans-serif; color: var(--hex-muted); }
  .pg-counter .pg-cur { color: var(--hex-gold); }
  .pg-dots { display: flex; gap: .35rem; flex-wrap: wrap; justify-content: center; }
  .pg-dot { width: .5rem; height: .5rem; border-radius: 50%; border: 0; cursor: pointer;
    background: rgba(212,160,23,.22); transition: background .15s, transform .12s; padding: 0; }
  .pg-dot:hover { background: rgba(212,160,23,.45); }
  .pg-dot.is-on { background: var(--hex-gold); transform: scale(1.25); }
  .pg-cap { font-size: .85rem; color: var(--hex-muted); text-align: center;
    min-height: 1.2rem; max-width: 40rem; }

  /* ── Lightbox ─────────────────────────────────────────────────────── */
  .pg-lb { position: fixed; inset: 0; z-index: 100; background: rgba(2,6,14,.97);
    display: flex; align-items: center; justify-content: center; padding: 2rem; }
  .pg-lb[hidden] { display: none; }
  .pg-lb-figure { margin: 0; display: flex; flex-direction: column; align-items: center; gap: .75rem;
    max-width: 100%; max-height: 100%; }
  .pg-lb-img { max-width: 92vw; max-height: 82vh; object-fit: contain; border-radius: .5rem;
    box-shadow: 0 20px 60px -10px rgba(0,0,0,.8); }
  .pg-lb-cap { font-size: .9rem; color: var(--hex-muted); text-align: center; max-width: 40rem; }
  .pg-lb-close, .pg-lb-nav { position: absolute; border: 0; cursor: pointer; color: var(--hex-gold);
    background: rgba(212,160,23,.1); border: 1px solid var(--hex-line-2); border-radius: 50%;
    display: grid; place-items: center; transition: background .15s, transform .12s; }
  .pg-lb-close { top: 1.25rem; right: 1.25rem; width: 2.6rem; height: 2.6rem; font-size: 1.2rem; }
  .pg-lb-nav { top: 50%; transform: translateY(-50%); width: 3rem; height: 3rem; font-size: 1.8rem; }
  .pg-lb-prev { left: 1.25rem; }
  .pg-lb-next { right: 1.25rem; }
  .pg-lb-close:hover, .pg-lb-nav:hover { background: rgba(212,160,23,.25); }
  .pg-lb-nav:hover { transform: translateY(-50%) scale(1.06); }

  @media (max-width: 560px) {
    .pg-nav { width: 2.1rem; height: 2.1rem; font-size: 1.3rem; }
    .pg-img { max-height: 50vh; }
  }
</style>

<script>
  // Wire every .pg on the page: carousel nav + scroll-synced dots/counter/caption + lightbox.
  document.querySelectorAll('[data-pg]').forEach((root) => {
    const track = root.querySelector('[data-pg-track]');
    const slides = [...root.querySelectorAll('.pg-slide')];
    const dots = [...root.querySelectorAll('.pg-dot')];
    const curEl = root.querySelector('[data-pg-cur]');
    const capEl = root.querySelector('[data-pg-cap]');
    const prev = root.querySelector('.pg-prev');
    const next = root.querySelector('.pg-next');
    const lb = root.querySelector('[data-pg-lb]');
    const lbImg = lb.querySelector('.pg-lb-img');
    const lbCap = lb.querySelector('[data-pg-lb-cap]');
    const lbPrev = lb.querySelector('.pg-lb-prev');
    const lbNext = lb.querySelector('.pg-lb-next');
    const lbClose = lb.querySelector('.pg-lb-close');
    let active = 0;
    let raf = 0;

    const slideW = () => track.clientWidth;

    function setActive(i) {
      i = Math.max(0, Math.min(slides.length - 1, i));
      active = i;
      dots.forEach((d, k) => d.classList.toggle('is-on', k === i));
      if (curEl) curEl.textContent = String(i + 1);
      if (capEl) capEl.textContent = slides[i]?.dataset.cap || '';
    }

    function onScroll() {
      if (raf) return;
      raf = requestAnimationFrame(() => {
        raf = 0;
        const i = Math.round(track.scrollLeft / slideW());
        if (i !== active) setActive(i);
      });
    }
    track.addEventListener('scroll', onScroll, { passive: true });

    function goTo(i) { track.scrollTo({ left: i * slideW(), behavior: 'smooth' }); }
    prev.addEventListener('click', () => goTo(active - 1));
    next.addEventListener('click', () => goTo(active + 1));
    dots.forEach((d) => d.addEventListener('click', () => goTo(+d.dataset.index)));

    // ── Lightbox ────────────────────────────────────────────────────
    function openLb(i) {
      i = Math.max(0, Math.min(slides.length - 1, i));
      active = i;
      const img = slides[i]?.querySelector('.pg-img');
      lbImg.src = img?.src || '';
      lbImg.alt = slides[i]?.dataset.cap || '';
      lbCap.textContent = slides[i]?.dataset.cap || '';
      lb.hidden = false;
      document.body.style.overflow = 'hidden';
      if (window.__lenis?.stop) window.__lenis.stop();
      setActive(i);
    }
    function closeLb() {
      lb.hidden = true;
      document.body.style.overflow = '';
      if (window.__lenis?.start) window.__lenis.start();
    }
    function lbStep(d) {
      let i = active + d;
      if (i < 0) i = slides.length - 1;
      if (i >= slides.length) i = 0;
      openLb(i);
    }
    slides.forEach((s, i) => s.querySelector('.pg-img')?.addEventListener('click', () => openLb(i)));
    lbPrev.addEventListener('click', () => lbStep(-1));
    lbNext.addEventListener('click', () => lbStep(1));
    lbClose.addEventListener('click', closeLb);
    lb.addEventListener('click', (e) => { if (e.target === lb) closeLb(); });
    document.addEventListener('keydown', (e) => {
      if (lb.hidden) return;
      if (e.key === 'Escape') closeLb();
      else if (e.key === 'ArrowLeft') lbStep(-1);
      else if (e.key === 'ArrowRight') lbStep(1);
    });

    setActive(0);
  });
</script>