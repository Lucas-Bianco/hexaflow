---
import { parts, subsystems, subsystemColor } from '../data/parts.js';

const partById = Object.fromEntries(parts.map(p => [p.id, p]));
function breadcrumb(p) {
  const chain = []; let cur = p;
  while (cur) { chain.unshift(cur); cur = cur.parentAssembly ? partById[cur.parentAssembly] : null; }
  return chain;
}
---

<section class="av">
  <p class="av-intro" data-reveal>
    The full HexaFlow nanolab, exported from SolidWorks. <strong>Click any part</strong> — on the
    model or in the list — to isolate it and read what it does. Use the toolbar to toggle wireframe,
    labels, fasteners, or explode the assembly apart.
  </p>

  <div class="av-grid" data-reveal>
    <!-- ── 3D viewer ─────────────────────────────────────────────────────── -->
    <div class="av-viewer-col">
      <div class="hf3d-host" id="hf3d-host">
        <div class="hf3d-loading" id="hf3d-loading">
          <div class="hf3d-spin"></div>
          <span>Loading 3D assembly…</span>
        </div>
        <div class="hf3d-stage" id="hf3d-stage"></div>
        <div class="hf3d-hint" id="hf3d-hint">Drag to orbit · Scroll to zoom · Click a part to isolate</div>
      </div>

      <!-- 3D toolbar -->
      <div class="hf3d-toolbar" id="hf3d-toolbar">
        <button id="hf-reset" title="Reset view + show all">↺ Show all</button>
        <label class="hf3d-chk"><input type="checkbox" id="hf-wireframe" /> Wireframe</label>
        <label class="hf3d-chk"><input type="checkbox" id="hf-labels" checked /> Labels</label>
        <label class="hf3d-chk"><input type="checkbox" id="hf-fasteners" /> Fasteners</label>
        <label class="hf3d-slider">Explode <input type="range" id="hf-explode" min="0" max="1" step="0.01" value="0" /></label>
        <button id="hf-fullscreen" title="Fullscreen" style="margin-left:auto">⛶</button>
      </div>
    </div>

    <!-- ── Parts list ───────────────────────────────────────────────────── -->
    <aside class="av-list">
      <input class="av-search" id="hf-search" type="search" placeholder="Filter parts…" aria-label="Filter parts" />
      <div class="av-list-scroll" id="hf-list-scroll">
        {subsystems.map(s => (
          <div class="av-group" data-subsystem={s.id}>
            <div class="av-group-head">
              <span class="av-dot" style={`background:${subsystemColor[s.id]}`}></span>
              <span class="av-group-name">{s.label}</span>
            </div>
            <p class="av-group-blurb">{s.blurb}</p>
            <div class="av-group-items">
              {parts.filter(p => p.subsystem === s.id).map(p => (
                <button class="av-row" data-part={p.id} style={`--accent:${subsystemColor[p.subsystem]}`}>
                  <span class="av-row-dot" style={`background:${subsystemColor[p.subsystem]}`}></span>
                  <span class="av-row-body">
                    <span class="av-row-name">{p.name}</span>
                    <span class="av-row-role">{p.role}</span>
                  </span>
                </button>
              ))}
            </div>
          </div>
        ))}
      </div>
    </aside>
  </div>

  <!-- ── Detail cards (one per part, only active shown) ─────────────────── -->
  <div class="av-details" id="hf-details">
    {parts.map(p => {
      const chain = breadcrumb(p);
      const files = (p.nativeFiles || []).map(f => f.split('/').pop());
      return (
        <article class="av-detail" data-part={p.id} hidden>
          <div class="av-detail-media">
            {p.image
              ? <img src={p.image} alt={p.name} loading="lazy" />
              : <div class="av-detail-noimg"><span>⬡</span><p>No render available — see native files</p></div>}
          </div>
          <div class="av-detail-info">
            <nav class="av-crumb" aria-label="Assembly path">
              {chain.map((c, i) => (
                <span>
                  <button data-part={c.id} class="av-crumb-btn">{c.name}</button>
                  {i < chain.length - 1 && <span class="av-crumb-sep">›</span>}
                </span>
              ))}
            </nav>
            <span class="av-tag" style={`--accent:${subsystemColor[p.subsystem]}`}>{p.subsystem}</span>
            <h2 class="av-detail-name">{p.name}</h2>
            <p class="av-detail-role">{p.role}</p>
            <p class="av-detail-desc">{p.description}</p>
            <div class="av-files">
              <h4>Files</h4>
              <div class="av-file-row">
                {p.drawingFile && (
                  <a class="av-dl av-dl-drawing" href={encodeURI(p.drawingFile)} target="_blank" rel="noopener">
                    View drawing ({p.drawingFile.split('.').pop().toUpperCase()})
                  </a>
                )}
                {files.map(f => (
                  <a class="av-dl" href={encodeURI('/cad-files/' + f)} download>⬇ {f}</a>
                ))}
              </div>
            </div>
          </div>
        </article>
      );
    })}
  </div>
</section>

<script>
  import { initViewer } from '../scripts/assembly3d.js';
  import { parts, subsystemColor, model } from '../data/parts.js';

  const $ = (s, r = document) => r.querySelector(s);
  const $$ = (s, r = document) => [...r.querySelectorAll(s)];

  let viewer = null;

  // ── Selection (DOM only; 3D is driven separately to avoid recursion) ──────
  function applySelectionDOM(id) {
    $$('.av-row').forEach(el => el.classList.toggle('is-active', el.dataset.part === id));
    $$('.av-detail').forEach(el => { el.hidden = el.dataset.part !== id; });
    const detail = $(`.av-detail[data-part="${id}"]`);
    if (detail && !detail.hidden) detail.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
    // scroll the list so the active row is visible
    const row = $(`.av-row[data-part="${id}"]`);
    if (row) row.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
  }

  function selectFromUI(id) {
    applySelectionDOM(id);
    if (viewer) viewer.select(id, { isolate: true });
  }

  $$('.av-row').forEach(el => el.addEventListener('click', () => selectFromUI(el.dataset.part)));
  $$('.av-crumb-btn').forEach(el => el.addEventListener('click', () => selectFromUI(el.dataset.part)));

  // ── Search ───────────────────────────────────────────────────────────────
  $('#hf-search').addEventListener('input', (e) => {
    const q = e.target.value.trim().toLowerCase();
    $$('.av-row').forEach(row => {
      const name = row.querySelector('.av-row-name').textContent.toLowerCase();
      const role = row.querySelector('.av-row-role').textContent.toLowerCase();
      row.style.display = (!q || name.includes(q) || role.includes(q)) ? '' : 'none';
    });
    $$('.av-group').forEach(g => { g.style.display = $$('.av-row', g).some(r => r.style.display !== 'none') ? '' : 'none'; });
  });

  // ── Boot the 3D viewer ────────────────────────────────────────────────────
  applySelectionDOM('nanolab-assembly');

  (async () => {
    try {
      viewer = await initViewer(document.getElementById('hf3d-stage'), {
        parts, subsystemColor, model,
        onSelect: (id) => applySelectionDOM(id),  // mesh click → DOM only (no recursion)
      });
      $('#hf3d-loading').style.display = 'none';
      $('#hf3d-hint').style.opacity = '1';
      // Show the whole assembly first (no isolation); the overview card is already visible.
      viewer.select('nanolab-assembly', { isolate: false });
    } catch (err) {
      console.error('HexaFlow 3D init failed:', err);
      $('#hf3d-loading').innerHTML =
        `<span>Could not load the 3D model.<br><code>${(err && err.message) ? err.message : err}</code><br><small>The parts list and details below still work.</small></span>`;
    }
  })();

  // ── 3D toolbar ────────────────────────────────────────────────────────────
  $('#hf-wireframe').addEventListener('change', e => viewer?.setWireframe(e.target.checked));
  $('#hf-labels').addEventListener('change', e => viewer?.setLabels(e.target.checked));
  $('#hf-fasteners').addEventListener('change', e => viewer?.setFastenersVisible(e.target.checked));
  $('#hf-explode').addEventListener('input', e => viewer?.setExplode(parseFloat(e.target.value)));
  $('#hf-reset').addEventListener('click', () => {
    viewer?.resetView();
    $('#hf-explode').value = 0;
    applySelectionDOM('nanolab-assembly');
  });
  $('#hf-fullscreen').addEventListener('click', () => viewer?.toggleFullscreen());
</script>

<style>
  .av { max-width: 72rem; margin: 0 auto; }
  .av-intro { color: var(--hex-muted); line-height: 1.65; font-size: 0.95rem; margin: 0 0 1.5rem; max-width: 46rem; }
  .av-intro strong { color: var(--hex-text); }

  .av-grid { display: grid; grid-template-columns: 1fr; gap: 1.25rem; }
  @media (min-width: 900px) { .av-grid { grid-template-columns: 1.5fr 1fr; align-items: start; } }

  /* ── 3D viewer ───────────────────────────────────────────────────────── */
  .av-viewer-col { display: flex; flex-direction: column; gap: .75rem; }
  .hf3d-host { position: relative; aspect-ratio: 4 / 3; border-radius: .9rem; overflow: hidden;
    background: #060e1c; border: 1px solid var(--hex-line);
    box-shadow: 0 18px 50px -20px rgba(0,0,0,0.8); }
  .hf3d-stage { position: absolute; inset: 0; }
  .hf3d-loading { position: absolute; inset: 0; display: flex; flex-direction: column;
    align-items: center; justify-content: center; gap: .75rem; color: var(--hex-muted);
    font-size: .9rem; z-index: 2; text-align: center; padding: 1rem; }
  .hf3d-loading code { color: #fda4af; font-size: .8rem; word-break: break-word; }
  .hf3d-spin { width: 30px; height: 30px; border-radius: 50%;
    border: 2px solid rgba(212,160,23,.25); border-top-color: var(--hex-gold);
    animation: hf3d-spin 0.8s linear infinite; }
  @keyframes hf3d-spin { to { transform: rotate(360deg); } }
  .hf3d-hint { position: absolute; left: 50%; bottom: .6rem; transform: translateX(-50%);
    font-size: .72rem; color: rgba(240,244,255,0.7); background: rgba(6,14,28,0.6);
    border: 1px solid var(--hex-line); padding: .25rem .6rem; border-radius: 999px;
    opacity: 0; transition: opacity .4s; pointer-events: none; white-space: nowrap; z-index: 2; }
  .hf3d-labels { position: absolute; inset: 0; pointer-events: none; z-index: 1; }
  .hf3d-label { position: absolute; top: 0; left: 0; display: flex; align-items: center; gap: .3rem;
    font: 600 .68rem 'Inter', sans-serif; color: #f0f4ff; background: rgba(6,14,28,0.82);
    border: 1px solid rgba(212,160,23,0.3); padding: .15rem .45rem; border-radius: .3rem;
    white-space: nowrap; transform-origin: 50% 100%; pointer-events: none; }
  .hf3d-label-dot { width: .45rem; height: .45rem; border-radius: 50%; }

  .hf3d-toolbar { display: flex; flex-wrap: wrap; align-items: center; gap: .6rem;
    padding: .6rem .8rem; background: var(--hex-card); border: 1px solid var(--hex-line); border-radius: .6rem; }
  .hf3d-toolbar button { background: rgba(212,160,23,.1); border: 1px solid rgba(212,160,23,.25); color: var(--hex-gold);
    border-radius: .4rem; padding: .4rem .75rem; font: 600 .8rem 'Inter', sans-serif; cursor: pointer; transition: background .15s; }
  .hf3d-toolbar button:hover { background: rgba(212,160,23,.18); }
  .hf3d-chk { display: inline-flex; align-items: center; gap: .35rem; color: #cbd5e1; font: 500 .8rem 'Inter', sans-serif; cursor: pointer; }
  .hf3d-chk input { accent-color: var(--hex-gold); }
  .hf3d-slider { display: inline-flex; align-items: center; gap: .4rem; color: #cbd5e1; font: 500 .8rem 'Inter', sans-serif; }
  .hf3d-slider input[type=range] { accent-color: var(--hex-gold); width: 100px; }

  /* ── List ─────────────────────────────────────────────────────────────── */
  .av-list { background: var(--hex-card); border: 1px solid var(--hex-line); border-radius: .9rem;
    display: flex; flex-direction: column; max-height: 40rem; }
  .av-search { margin: .75rem; padding: .55rem .8rem; background: #060e1c;
    border: 1px solid rgba(212,160,23,.2); border-radius: .5rem; color: #f0f4ff; font: 500 .85rem 'Inter', sans-serif; }
  .av-search:focus { outline: none; border-color: rgba(212,160,23,.5); }
  .av-list-scroll { overflow-y: auto; padding: 0 .75rem .75rem; }
  .av-group { margin-bottom: 1rem; }
  .av-group-head { display: flex; align-items: center; gap: .5rem; }
  .av-dot { width: .6rem; height: .6rem; border-radius: 50%; }
  .av-group-name { font: 700 .72rem 'Space Grotesk', sans-serif; color: #fff; text-transform: uppercase; letter-spacing: .08em; }
  .av-group-blurb { font-size: .72rem; color: #64748b; margin: .25rem 0 .5rem; line-height: 1.5; }
  .av-row { display: flex; gap: .65rem; width: 100%; text-align: left; background: transparent;
    border: 1px solid transparent; border-radius: .5rem; padding: .5rem .6rem; cursor: pointer; transition: background .12s, border-color .12s; }
  .av-row:hover { background: rgba(212,160,23,.06); border-color: rgba(212,160,23,.15); }
  .av-row.is-active { background: rgba(212,160,23,.12); border-color: rgba(212,160,23,.4); }
  .av-row-dot { flex-shrink: 0; width: .55rem; height: .55rem; border-radius: 50%; margin-top: .35rem; }
  .av-row-body { display: flex; flex-direction: column; }
  .av-row-name { font: 600 .85rem 'Inter', sans-serif; color: #e2e8f0; }
  .av-row-role { font-size: .72rem; color: #64748b; line-height: 1.4; }

  /* ── Detail ───────────────────────────────────────────────────────────── */
  .av-details { margin-top: 1.75rem; }
  .av-detail { display: grid; gap: 1.5rem; background: var(--hex-card); border: 1px solid var(--hex-line);
    border-radius: .9rem; padding: 1.5rem; }
  @media (min-width: 760px) { .av-detail { grid-template-columns: 1fr 1.2fr; } }
  .av-detail-media img { width: 100%; border-radius: .6rem; display: block; background: #060e1c; }
  .av-detail-noimg { aspect-ratio: 4/3; display: flex; flex-direction: column; align-items: center; justify-content: center;
    gap: .5rem; background: #060e1c; border-radius: .6rem; color: #64748b; }
  .av-detail-noimg span { font-size: 3rem; color: rgba(212,160,23,.3); }
  .av-crumb { display: flex; flex-wrap: wrap; align-items: center; gap: .25rem; margin-bottom: .75rem; }
  .av-crumb-btn { background: none; border: 0; color: #7090b8; font: 600 .8rem 'Inter', sans-serif; padding: 0; cursor: pointer; }
  .av-crumb-btn:hover { color: var(--hex-gold); }
  .av-crumb-sep { color: #475569; margin: 0 .15rem; }
  .av-tag { display: inline-block; font: 600 .68rem 'Space Grotesk', sans-serif; text-transform: uppercase; letter-spacing: .08em;
    color: var(--accent); background: color-mix(in srgb, var(--accent) 12%, transparent);
    border: 1px solid color-mix(in srgb, var(--accent) 30%, transparent);
    padding: .2rem .6rem; border-radius: 999px; margin-bottom: .75rem; }
  .av-detail-name { font: 700 1.6rem 'Space Grotesk', sans-serif; color: #fff; margin: 0 0 .25rem; }
  .av-detail-role { font: 600 1rem 'Inter', sans-serif; color: var(--hex-gold); margin: 0 0 .75rem; }
  .av-detail-desc { color: var(--hex-muted); line-height: 1.7; margin: 0 0 1.25rem; }
  .av-files h4 { font: 700 .72rem 'Space Grotesk', sans-serif; text-transform: uppercase; letter-spacing: .08em; color: #64748b; margin: 0 0 .5rem; }
  .av-file-row { display: flex; flex-wrap: wrap; gap: .5rem; }
  .av-dl { display: inline-flex; align-items: center; gap: .3rem; padding: .45rem .75rem; border-radius: .45rem;
    font: 600 .78rem 'Inter', sans-serif; text-decoration: none; background: rgba(212,160,23,.08);
    border: 1px solid rgba(212,160,23,.25); color: var(--hex-gold); transition: background .15s; }
  .av-dl:hover { background: rgba(212,160,23,.16); }
  .av-dl-drawing { background: rgba(147,197,253,.08); border-color: rgba(147,197,253,.3); color: #93c5fd; }
</style>