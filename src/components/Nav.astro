---
const navLinks = [
  { href: '/',                     label: 'Home' },
  { href: '/geometry',             label: 'Geometry' },
  { href: '/drop-testing',         label: 'Drop Testing' },
  { href: '/ai-control',           label: 'AI & Control' },
  { href: '/user-interface',       label: 'User Interface' },
  { href: '/aeroponics',           label: 'Aeroponics' },
  { href: '/secondary-substrates', label: 'Secondary Substrates' },
  { href: '/substrate-covers',     label: 'Substrate Covers' },
  { href: '/assembly',             label: 'Assembly Viewer' },
  { href: '/modular-enclosure',    label: 'Modular Enclosure' },
  { href: '/cad-drawings',         label: 'CAD Drawings + Photos' },
  { href: '/full-project-photos',  label: 'Full Project Photos' },
  { href: '/bom',                  label: 'BOM' },
  { href: '/prototyping',          label: 'Prototyping Iteration' },
  { href: '/sources',              label: 'Misc. Sources' },
];

const path = Astro.url.pathname.replace(/\/$/, '') || '/';
---

<nav style="position:fixed;top:0;left:0;right:0;z-index:50;height:4rem;
            background:#091829;border-bottom:1px solid rgba(212,160,23,0.15);
            display:flex;align-items:center;gap:1rem;padding:0 1.25rem;">

  <!-- Logo -->
  <a href="/" style="display:flex;align-items:center;gap:0.5rem;text-decoration:none;flex-shrink:0;">
    <svg width="28" height="28" viewBox="0 0 100 100">
      <polygon points="50,4 96,28 96,72 50,96 4,72 4,28"
               fill="rgba(212,160,23,0.12)" stroke="#d4a017" stroke-width="5"/>
      <text x="50" y="66" text-anchor="middle" fill="#d4a017"
            font-size="46" font-family="Inter,sans-serif" font-weight="700">H</text>
    </svg>
    <span style="font-family:'Space Grotesk',sans-serif;font-size:1.1rem;
                 font-weight:700;color:#fff;letter-spacing:-0.01em;">HexaFlow</span>
  </a>

  <!-- Desktop scrollable nav -->
  <div class="no-scrollbar" style="display:none;flex:1;overflow-x:auto;gap:0.15rem;align-items:center;"
       id="desktop-nav">
    {navLinks.map(link => {
      const active = path === link.href || (link.href !== '/' && path.startsWith(link.href));
      return (
        <a href={link.href}
           style={`white-space:nowrap;padding:0.35rem 0.7rem;border-radius:0.4rem;
                   font-size:0.82rem;font-weight:500;text-decoration:none;transition:all 0.15s;
                   color:${active ? '#d4a017' : '#94a3b8'};
                   background:${active ? 'rgba(212,160,23,0.1)' : 'transparent'};`}>
          {link.label}
        </a>
      );
    })}
  </div>

  <!-- Mobile hamburger -->
  <button id="nav-toggle" aria-label="Menu"
          style="margin-left:auto;display:flex;flex-direction:column;gap:5px;
                 background:none;border:none;cursor:pointer;padding:8px;">
    <span id="b1" style="display:block;width:20px;height:2px;background:#d4a017;border-radius:2px;transition:all 0.2s;"></span>
    <span id="b2" style="display:block;width:20px;height:2px;background:#d4a017;border-radius:2px;transition:all 0.2s;"></span>
    <span id="b3" style="display:block;width:20px;height:2px;background:#d4a017;border-radius:2px;transition:all 0.2s;"></span>
  </button>
</nav>

<!-- Mobile menu -->
<div id="mobile-menu"
     style="display:none;position:fixed;inset:0;top:4rem;z-index:40;
            background:#060e1c;overflow-y:auto;padding:1rem;">
  {navLinks.map(link => {
    const active = path === link.href || (link.href !== '/' && path.startsWith(link.href));
    return (
      <a href={link.href}
         style={`display:block;padding:0.85rem 1rem;border-radius:0.5rem;
                 font-size:0.95rem;font-weight:500;text-decoration:none;margin-bottom:0.25rem;
                 color:${active ? '#d4a017' : '#94a3b8'};
                 background:${active ? 'rgba(212,160,23,0.08)' : 'transparent'};
                 border:1px solid ${active ? 'rgba(212,160,23,0.25)' : 'transparent'};`}>
        {link.label}
      </a>
    );
  })}
</div>

<style>
  @media (min-width: 768px) {
    #desktop-nav { display: flex !important; }
    #nav-toggle  { display: none !important; }
  }
</style>

<script>
  const toggle = document.getElementById('nav-toggle')!;
  const menu   = document.getElementById('mobile-menu')!;
  const b1 = document.getElementById('b1')!;
  const b2 = document.getElementById('b2')!;
  const b3 = document.getElementById('b3')!;
  let open = false;

  toggle.addEventListener('click', () => {
    open = !open;
    menu.style.display = open ? 'block' : 'none';
    b1.style.transform = open ? 'translateY(7px) rotate(45deg)' : '';
    b2.style.opacity   = open ? '0' : '1';
    b3.style.transform = open ? 'translateY(-7px) rotate(-45deg)' : '';
  });

  menu.querySelectorAll('a').forEach(a => a.addEventListener('click', () => {
    open = false;
    menu.style.display = 'none';
    b1.style.transform = b3.style.transform = '';
    b2.style.opacity = '1';
  }));
</script>
