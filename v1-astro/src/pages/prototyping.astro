---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import PageShell from '../components/PageShell.astro';
import VideoFigure from '../components/VideoFigure.astro';
---
<Layout title="Prototyping Iteration">
  <Nav slot="nav" />

  <PageShell
    title="Prototyping Iteration"
    subtitle="Iterative design and testing, traced from early concept builds through the final CDR prototype."
    badge="Process"
  >
    <div style="display:grid;gap:2rem;">

      <!-- External doc link -->
      <div data-reveal style="display:flex;align-items:center;gap:1rem;flex-wrap:wrap;">
        <div>
          <div class="font-display" style="font-weight:700;color:#fff;margin-bottom:0.3rem;">
            Prototyping &amp; Testing Document
          </div>
          <div style="font-size:0.875rem;color:var(--hex-muted-2);">
            The full iteration log is maintained alongside the CDR documentation.
          </div>
        </div>
      </div>

      <!-- Known iteration notes -->
      <div>
        <h2 class="font-display kinetic" data-kinetic="word" data-reveal style="font-size:1.3rem;font-weight:700;color:#fff;margin:0 0 0.75rem;">
          Iteration Summary
        </h2>
        <p style="color:#94a3b8;font-size:0.9rem;line-height:1.7;margin:0 0 1.25rem;">
          The major milestones that shaped the design — each one a deliberate response to what the
          previous build revealed.
        </p>
        <div class="iter-grid" data-reveal style="display:grid;gap:1rem;">
          {[
            { phase:'Substrate Testing',   desc:'Tested 8 materials — pine bark showed growth; all developed mold → pivoted to aeroponics.' },
            { phase:'TDC V1',              desc:'First hexagonal capillary plate using SLA resin. Verified capillary action and inversion water retention at 10.12mL capacity.' },
            { phase:'TDC V2',              desc:'Combined resin construction with 3D-printed framing to reduce weight and cost. Added a camera slot for pump/reservoir monitoring.' },
            { phase:'Drop Test Iteration', desc:'Refined drop test configuration — removed TDS/pH sensors, upgraded to a high-capacity pump targeting 8.63 mL in 5.18 s.' },
            { phase:'AI Integration',      desc:'Vision model trained on root moisture data. Dual-mode AI system implemented (drop test vs. long-term).' },
            { phase:'Custom Carrier Board',desc:'Consolidated electronics: RPi, 4-camera hub, direct ADC, power breakouts — simplified wiring for reliability.' },
          ].map(p => (
            <div class="card" style="display:grid;grid-template-columns:auto 1fr;gap:1.25rem;align-items:start;">
              <div style="width:10px;height:10px;border-radius:50%;background:rgba(212,160,23,0.4);
                           border:2px solid #d4a017;flex-shrink:0;margin-top:4px;"></div>
              <div>
                <div class="font-display" style="font-weight:700;color:#fff;margin-bottom:0.3rem;font-size:0.95rem;">{p.phase}</div>
                <div style="font-size:0.875rem;color:var(--hex-muted-2);line-height:1.6;">{p.desc}</div>
              </div>
            </div>
          ))}
        </div>
      </div>

      <!-- V1 vs V2 comparison footage -->
      <div data-reveal>
        <h2 class="font-display kinetic" data-kinetic="word" data-reveal style="font-size:1.3rem;font-weight:700;color:#fff;margin:0 0 0.75rem;">
          TDC V1 vs V2
        </h2>
        <p style="color:#94a3b8;font-size:0.9rem;line-height:1.7;margin:0 0 1.25rem;">
          The two capillary module generations side by side — what changed between the first
          SLA plate and the V2 assembly that replaced most of the resin with printed framing.
        </p>
        <VideoFigure
          src="/video/orientation-v1-v2.mp4"
          poster="/video/orientation-v1-v2-poster.jpg"
          caption="TDC V1 and V2 compared in orientation testing."
        />
      </div>

    </div>
  </PageShell>

  <Footer slot="footer" />
</Layout>

<style>
  /* Opacity-only stagger so we never fight the .card hover-lift transform. */
  .iter-grid > .card { opacity: 0; transition: opacity .6s ease; }
  .iter-grid.is-in > .card { opacity: 1; }
  .iter-grid.is-in > .card:nth-child(2) { transition-delay: .08s; }
  .iter-grid.is-in > .card:nth-child(3) { transition-delay: .16s; }
  .iter-grid.is-in > .card:nth-child(4) { transition-delay: .24s; }
  .iter-grid.is-in > .card:nth-child(5) { transition-delay: .32s; }
  .iter-grid.is-in > .card:nth-child(6) { transition-delay: .40s; }
  @media (prefers-reduced-motion: reduce) {
    .iter-grid > .card { opacity: 1 !important; }
  }
</style>
