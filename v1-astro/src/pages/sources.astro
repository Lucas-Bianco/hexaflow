---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import PageShell from '../components/PageShell.astro';

const groups = [
  {
    cat: 'Geometry & Biomimicry',
    refs: [
      { title: 'Skin morphology study of Moloch horridus', note: 'ResearchGate — primary source for thorny devil capillary channel geometry' },
      { title: 'Capillary action in micro-scale channels', note: 'Fluid transport without gravity; polar adhesion properties of resin materials' },
      { title: 'Hexagonal geometry in biological systems', note: 'Honeycomb efficiency, channel optimization principles' },
    ],
  },
  {
    cat: 'Aeroponics',
    refs: [
      { title: 'LettUs Grow',                 note: 'Aeroponic growing systems and efficiency data (98% water savings)' },
      { title: 'Atlas Scientific',             note: 'Contact-free pH probe — selected over the Arduino Gravity glass-reed sensor, which cannot work in microgravity', url: 'https://atlas-scientific.com' },
      { title: 'Food Gardening Network',       note: 'Suitable and unsuitable crops for aeroponic growing' },
      { title: 'NASA Science',                 note: 'Plant growth research in space environments' },
      { title: 'Agrotonomy',                   note: 'Commercial aeroponics and root zone oxygen studies' },
      { title: 'NoSoilSolutions',              note: 'Hydroponic and aeroponic media comparisons' },
      { title: 'Greenhouse Canada',            note: 'Controlled environment agriculture and substrate research' },
      { title: 'NASA XROOTS Program Documentation', note: 'Sierra Space eXposed Root On-Orbit Test System' },
    ],
  },
  {
    cat: 'Secondary Substrates',
    refs: [
      { title: 'Plant nutrition in hydroponic systems',      note: 'Nutrient uptake in soil-free growing environments' },
      { title: 'Rockwool as a growing medium',               note: 'Water retention, sterility, and root penetrability' },
      { title: 'Clay pebbles in hydroponics',                note: 'Drainage, microgravity containment, and root support' },
      { title: 'Illite clay mineral properties',             note: 'Microgravity feasibility and system compatibility' },
      { title: 'Pine bark as a substrate',                   note: 'Preliminary test results — only material showing growth' },
      { title: 'NASA space agriculture research (28 refs)',  note: 'Full citation list maintained in Google Sheets / project docs' },
    ],
  },
  {
    cat: 'Space Agriculture & Microgravity',
    refs: [
      { title: 'China Lunar Farming Program',     note: 'Integration of aeroponics into lunar surface agriculture' },
      { title: 'Sierra Space Astro Garden',       note: 'XROOTS — aeroponic plant cultivation for long-duration spaceflight' },
      { title: 'ISS VEGGIE Experiment',           note: 'NASA plant growth hardware aboard the International Space Station' },
      { title: 'Advanced Plant Habitat (APH)',    note: 'Controlled environment chamber for plant research on ISS' },
    ],
  },
  {
    cat: 'Electronics & Software',
    refs: [
      { title: 'Raspberry Pi documentation',  note: 'GPIO, USB, and carrier board integration references' },
      { title: 'OpenCV / computer vision',    note: 'Plant root moisture detection via image analysis' },
      { title: 'GitHub — AidanForrester/TC-HUNCH-Nanolab', note: 'Project version control and UI development log', url: 'https://github.com/AidanForrester/TC-HUNCH-Nanolab' },
    ],
  },
  {
    cat: 'Patents & Prior Art',
    refs: [
      { title: 'CN105638413A — Plant cultivation in microgravity', note: 'Reviewed during the existing-solutions survey', url: 'https://patents.google.com/patent/CN105638413A' },
      { title: 'US20220369580A1 — Plant growth system',            note: 'Reviewed during the existing-solutions survey', url: 'https://patents.google.com/patent/US20220369580A1' },
      { title: 'CN108633718A — Cultivation apparatus',             note: 'Reviewed during the existing-solutions survey', url: 'https://patents.google.com/patent/CN108633718A' },
    ],
  },
  {
    cat: 'Components',
    refs: [
      { title: 'Adafruit 4026 — Capacitive soil moisture sensor', note: 'Chosen over resistive probes, which oxidise in continuous contact with water', url: 'https://www.adafruit.com/product/4026' },
    ],
  },
  {
    cat: 'Media Credits',
    refs: [
      { title: 'Thorny devil (Moloch horridus) photograph', note: 'Wikimedia Commons — used on the Geometry page', url: 'https://commons.wikimedia.org/wiki/File:Thorny_dragon.jpg' },
    ],
  },
  {
    cat: 'Site Colophon',
    refs: [
      { title: 'Astro',     note: 'Static site framework behind these 16 pages', url: 'https://astro.build' },
      { title: 'Three.js',  note: 'WebGL renderer powering the interactive Assembly Viewer', url: 'https://threejs.org' },
      { title: 'Lenis',     note: 'Smooth-scroll library driving the scroll-linked sections', url: 'https://lenis.darkroom.engineering' },
      { title: 'Tailwind CSS', note: 'Utility layer used alongside the project design tokens', url: 'https://tailwindcss.com' },
    ],
  },
];
---
<Layout title="Misc. Sources">
  <Nav slot="nav" />

  <PageShell
    title="Misc. Sources"
    subtitle="Research references, programs, and documentation cited across every HexaFlow project section."
    badge="References"
  >
    <div style="display:grid;gap:2.5rem;">
      {groups.map((g, gi) => (
        <div>
          <h2 class="font-display" style="font-size:1.25rem;font-weight:700;color:#fff;margin:0 0 1rem;
                      display:flex;align-items:center;gap:0.75rem;">
            <span style="display:inline-block;width:4px;height:1.25rem;background:#d4a017;border-radius:2px;flex-shrink:0;"></span>
            {gi === 0 ? <span class="kinetic" data-kinetic="word" data-reveal>{g.cat}</span> : g.cat}
          </h2>
          <div class="refs-grid" data-reveal style="display:grid;gap:0.6rem;">
            {g.refs.map(r => {
              const Tag = r.url ? 'a' : 'div';
              return (
                <Tag class="card ref" href={r.url} target={r.url ? '_blank' : undefined}
                     rel={r.url ? 'noopener noreferrer' : undefined}
                     style="padding:1rem 1.25rem;display:block;text-decoration:none;">
                  <div class="ref-t">{r.title}{r.url && <span class="ref-x" aria-hidden="true"> ↗</span>}</div>
                  <div class="ref-n">{r.note}</div>
                  {r.url && <div class="ref-u">{r.url.replace(/^https?:\/\//, '')}</div>}
                </Tag>
              );
            })}
          </div>
        </div>
      ))}

      <div data-reveal style="padding:1.25rem;border-radius:0.75rem;background:rgba(212,160,23,0.04);
                  border:1px solid rgba(212,160,23,0.12);">
        <p style="font-size:0.875rem;color:var(--hex-muted-2);margin:0;line-height:1.65;">
          Entries with a <span style="color:#d4a017;">↗</span> link to a verified primary source. The
          remaining entries name the work consulted but are pending full citation (author, year, DOI);
          they are listed here rather than omitted so the research trail stays visible. The secondary
          substrates work additionally draws on <strong style="color:#94a3b8;">28 academic sources</strong>
          held with the project documentation.
        </p>
      </div>
    </div>
  </PageShell>

  <Footer slot="footer" />
</Layout>

<style>
  .ref-t { font-weight: 600; color: #e2e8f0; font-size: 0.9rem; margin-bottom: 0.25rem; }
  .ref-n { font-size: 0.825rem; color: var(--hex-muted-2); }
  .ref-u { font-size: 0.75rem; color: var(--hex-gold); margin-top: 0.4rem;
           word-break: break-all; opacity: 0.85; }
  .ref-x { color: var(--hex-gold); font-size: 0.8em; }
  a.ref:hover .ref-u, a.ref:focus-visible .ref-u { opacity: 1; text-decoration: underline; }

  /* Opacity-only stagger so we never fight the .card hover-lift transform. */
  .refs-grid > .card { opacity: 0; transition: opacity .6s ease; }
  .refs-grid.is-in > .card { opacity: 1; }
  .refs-grid.is-in > .card:nth-child(2) { transition-delay: .08s; }
  .refs-grid.is-in > .card:nth-child(3) { transition-delay: .16s; }
  .refs-grid.is-in > .card:nth-child(4) { transition-delay: .24s; }
  .refs-grid.is-in > .card:nth-child(5) { transition-delay: .32s; }
  .refs-grid.is-in > .card:nth-child(6) { transition-delay: .40s; }
  .refs-grid.is-in > .card:nth-child(7) { transition-delay: .48s; }
  .refs-grid.is-in > .card:nth-child(8) { transition-delay: .56s; }
  @media (prefers-reduced-motion: reduce) {
    .refs-grid > .card { opacity: 1 !important; }
  }
</style>
